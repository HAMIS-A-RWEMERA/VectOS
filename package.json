        "@types/multer": "^2.2.0",
        "@types/sql.js": "^1.4.11",
        "@vitejs/plugin-react": "^5.0.4",
        "bcryptjs": "^3.0.3",
        "connect-pg-simple": "^10.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.2.3",
        "ejs": "^6.0.1",
        "express": "^4.21.2",
        "express-session": "^1.19.0",
        "helmet": "^8.3.0",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "multer": "^2.2.0",
        "otplib": "^13.5.0",
        "pg": "^8.23.0",
        "qrcode": "^1.5.4",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "serverless-http": "^4.0.0",
