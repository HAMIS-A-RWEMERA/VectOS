{
    "name": "react-example",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx server.ts",
        "build": "npx tailwindcss -i styles-src/tailwind.input.css -o public/styles/tailwind.css --minify && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "start": "node dist/server.cjs",
        "clean": "rm -rf dist server.js",
        "lint": "tsc --noEmit",
        "test": "vitest run",
        "test:pg": "vitest run"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/vite": "^4.1.14",
