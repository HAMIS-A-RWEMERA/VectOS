{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": "database-schema.sql"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api|assets|public|styles|sw\\.js|workbox-.*|manifest\\.webmanifest|manifest\\.json|pwa-.*|apple-touch-icon\\.png|icon\\.svg|offline\\.html).*)", "destination": "/index.html" }
  ]
}
