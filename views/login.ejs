<%- include('partials/header', { title: 'Sign In — VectOS Depot ERP' }) %>

<div class="min-h-screen bg-[#0A0C0F] flex flex-col justify-center py-10 px-4 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <!-- VectOS Logo Icon -->
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 font-black shadow-xl shadow-amber-500/20 mb-3">
      <i data-lucide="layers" class="w-8 h-8"></i>
    </div>
    <h2 class="text-3xl font-extrabold text-white tracking-tight font-display">VectOS</h2>
    <p class="mt-1 text-xs text-amber-400 font-semibold tracking-wider uppercase">Operating System for Hardware & Electronics Depots • Rwanda</p>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-[#13161C] py-8 px-6 shadow-2xl rounded-2xl border border-[#222732] sm:px-10 space-y-6">
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-300 text-xs flex items-start space-x-2.5">
          <i data-lucide="alert-circle" class="w-4 h-4 text-rose-400 shrink-0 mt-0.5"></i>
          <span class="leading-relaxed"><%= error %></span>
        </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Work Email Address</label>
          <div class="mt-1.5 relative">
            <input id="email" name="email" type="email" autocomplete="email" required
              placeholder="e.g. manager@yourcompany.rw"
              class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all">
          </div>
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider">Password</label>
          <div class="mt-1.5">
            <input id="password" name="password" type="password" required
              placeholder="••••••••"
              class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500 transition-all">
          </div>
        </div>

        <button type="submit"
          class="w-full flex justify-center items-center py-3.5 px-4 border border-transparent rounded-xl shadow-lg text-sm font-bold text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 focus:outline-none transition-all cursor-pointer">
          Sign In to Portal
        </button>
      </form>

      <div class="text-center">
        <a href="/forgot-password" class="text-xs text-slate-400 hover:text-amber-400 transition-colors">Forgot your password?</a>
      </div>

      <!-- Demo Access (for live presentations) -->
      <div class="text-center pt-1">
        <button type="button" onclick="fillDemo()" class="inline-flex items-center space-x-1.5 px-3 py-2 bg-[#1E232E] hover:bg-[#2B313E] text-slate-300 hover:text-white border border-[#2B313E] rounded-lg text-xs font-semibold transition-all cursor-pointer">
          <i data-lucide="play-circle" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Try the Live Demo</span>
        </button>
      </div>

      <!-- Register New Depot Link -->
      <div class="p-4 bg-gradient-to-b from-[#181D26] to-[#141820] border border-[#2B313E] rounded-xl text-center space-y-2">
        <p class="text-xs font-bold text-white">Own a Hardware (Quincaillerie) or Electronics Store?</p>
        <p class="text-[11px] text-slate-400">
          Register your company and get a private portal with inventory, sales, and receipt printing — flexible billing arranged directly with the VectOS team.
        </p>
        <div class="pt-1">
          <a href="/register-shop" class="inline-flex items-center space-x-1.5 px-3 py-2 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 hover:text-amber-300 border border-amber-500/30 rounded-lg text-xs font-bold transition-all">
            <i data-lucide="store" class="w-3.5 h-3.5"></i>
            <span>Register Your Company on VectOS &rarr;</span>
          </a>
        </div>
      </div>

      <div class="pt-2 text-center">
        <p class="text-[11px] text-slate-500 flex items-center justify-center space-x-1">
          <i data-lucide="shield-check" class="w-3.5 h-3.5 text-slate-400"></i>
          <span>VectOS Secure Multi-Tenant Architecture</span>
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  function fillDemo() {
    var e = document.getElementById('email');
    var p = document.getElementById('password');
    if (e && p) { e.value = 'manager@quincaille.rw'; p.value = 'password123'; }
  }
</script>

<%- include('partials/footer') %>
