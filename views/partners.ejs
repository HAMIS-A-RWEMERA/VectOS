<%- include('partials/header', { title: 'Partner Shops Directory — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="pb-4 border-b border-[#222732] flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
          Partner Suppliers & Hardware Shops
        </h1>
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          Internal View Only
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        External Nyabugogo/Gisozi suppliers used when main inventory is unavailable. Information is strictly internal.
      </p>
    </div>

    <% if (user.role === 'manager') { %>
      <button onclick="document.getElementById('addPartnerModal').classList.remove('hidden')"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all">
        <i data-lucide="plus" class="w-4 h-4"></i>
        <span>Add Partner Supplier</span>
      </button>
    <% } %>
  </div>

  <!-- Partner Directory Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <% partners.forEach(p => { %>
      <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl space-y-4 hover:border-indigo-500/40 transition-all">
        <div class="flex items-start justify-between">
          <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center font-bold">
            <i data-lucide="store" class="w-5 h-5"></i>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-[#1D222B] text-slate-400">
            PART-<%= String(p.id).padStart(3, '0') %>
          </span>
        </div>

        <div>
          <h3 class="text-base font-bold text-white"><%= p.name %></h3>
          <p class="text-xs text-slate-400 font-medium">Contact: <%= p.contact_person %></p>
          <p class="text-xs text-slate-400 font-mono"><%= p.phone %></p>
          <p class="text-xs text-slate-500 mt-1"><%= p.address || 'Kigali, Rwanda' %></p>
        </div>

        <div class="pt-3 border-t border-[#222732] flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">Current Outstanding Payable:</span>
          <span class="font-mono font-black text-amber-400 text-sm">RWF <%= p.current_balance.toLocaleString('en-US') %></span>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- Add Partner Modal -->
<% if (user.role === 'manager') { %>
<div id="addPartnerModal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#222732]">
      <h3 class="text-base font-bold text-white">Register Partner Hardware Shop</h3>
      <button onclick="document.getElementById('addPartnerModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/partners/add" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Shop / Business Name</label>
        <input type="text" name="name" required placeholder="e.g. Bimaco Hardware Nyabugogo"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Contact Person Name</label>
        <input type="text" name="contact_person" required placeholder="e.g. Alain Bimenyimana"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Phone Number</label>
        <input type="text" name="phone" required placeholder="e.g. +250 788 777 888"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Market Location / Address</label>
        <input type="text" name="address" placeholder="e.g. Nyabugogo Bus Park Area"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div class="pt-3 flex justify-end space-x-3">
        <button type="button" onclick="document.getElementById('addPartnerModal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl bg-[#222834] text-xs font-bold text-slate-300">Cancel</button>
        <button type="submit"
          class="px-5 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs hover:bg-amber-400">Save Supplier</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<%- include('partials/footer') %>
