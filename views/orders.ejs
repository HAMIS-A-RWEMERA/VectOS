<%- include('partials/header', { title: 'Orders Directory — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[#222732]">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
        Sales & Operational Orders
      </h1>
      <p class="text-xs text-slate-400 mt-1">
        Monitor order progression, fulfillment statuses, payment records, and client receipts.
      </p>
    </div>

    <% if (user.role === 'salesperson' || user.role === 'manager') { %>
      <a href="/orders/new"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Create New Order</span>
      </a>
    <% } %>
  </div>

  <!-- Status Filter Bar -->
  <div class="flex items-center space-x-2 overflow-x-auto pb-2 text-xs">
    <a href="/orders" class="px-3.5 py-2 rounded-xl transition-all font-bold <%= !filterStatus ? 'bg-amber-500 text-slate-950' : 'bg-[#13161C] border border-[#222732] text-slate-300 hover:text-white' %>">
      All Orders
    </a>
    <a href="/orders?status=pending_store" class="px-3.5 py-2 rounded-xl transition-all font-bold <%= filterStatus === 'pending_store' ? 'bg-amber-500 text-slate-950' : 'bg-[#13161C] border border-[#222732] text-slate-300 hover:text-white' %>">
      Pending Store Dispatch
    </a>
    <a href="/orders?status=resolving_rejected" class="px-3.5 py-2 rounded-xl transition-all font-bold <%= filterStatus === 'resolving_rejected' ? 'bg-rose-500 text-white' : 'bg-[#13161C] border border-[#222732] text-slate-300 hover:text-white' %>">
      Rejected Items Action
    </a>
    <a href="/orders?status=completed" class="px-3.5 py-2 rounded-xl transition-all font-bold <%= filterStatus === 'completed' ? 'bg-emerald-500 text-slate-950' : 'bg-[#13161C] border border-[#222732] text-slate-300 hover:text-white' %>">
      Completed Orders
    </a>
    <a href="/orders?status=debt" class="px-3.5 py-2 rounded-xl transition-all font-bold <%= filterStatus === 'debt' ? 'bg-rose-500 text-white' : 'bg-[#13161C] border border-[#222732] text-slate-300 hover:text-white' %>">
      Debt Payment Status
    </a>
  </div>

  <!-- Orders Table -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[#222732] bg-[#181C24] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4">Order Number</th>
            <th class="py-3.5 px-4">Customer</th>
            <th class="py-3.5 px-4">Salesperson</th>
            <th class="py-3.5 px-4 text-right">Grand Total (RWF)</th>
            <th class="py-3.5 px-4 text-center">Payment Status</th>
            <th class="py-3.5 px-4 text-center">Fulfillment Status</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1D222B] text-xs">
          <% if (orders && orders.length > 0) { %>
            <% orders.forEach(o => { %>
              <tr class="hover:bg-[#1A1E26] transition-colors">
                <td class="py-3.5 px-4 font-mono font-bold text-amber-400"><%= o.order_number %></td>
                <td class="py-3.5 px-4 font-bold text-white"><%= o.customer_name %></td>
                <td class="py-3.5 px-4 text-slate-300"><%= o.salesperson_name %></td>
                <td class="py-3.5 px-4 text-right font-mono font-bold text-slate-200">
                  <%= o.total_amount.toLocaleString('en-US') %>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= o.payment_status === 'paid' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : o.payment_status === 'partial' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                    <%= o.payment_status %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-center">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= o.fulfillment_status === 'completed' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : o.fulfillment_status === 'resolving_rejected' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-blue-500/10 text-blue-400 border border-blue-500/20' %>">
                    <%= o.fulfillment_status.replace('_', ' ') %>
                  </span>
                </td>
                <td class="py-3.5 px-4 text-right space-x-2">
                  <a href="/orders/<%= o.id %>" class="px-2.5 py-1 rounded-lg bg-[#222834] hover:bg-[#2C3444] text-slate-200 font-semibold transition-colors">
                    Internal Details
                  </a>
                  <a href="/orders/<%= o.id %>/receipt" target="_blank" class="px-2.5 py-1 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 font-semibold transition-colors border border-amber-500/20">
                    Print Receipt
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-500 text-xs">No orders logged matching criteria.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
