<%- include('partials/header', { title: 'Storekeeper Dispatch Queue — Quincaille IOMS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="pb-4 border-b border-[#222732]">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-400 flex items-center justify-center font-bold">
        <i data-lucide="warehouse" class="w-5 h-5"></i>
      </div>
      <div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
          Storekeeper Inventory Dispatch Review
        </h1>
        <p class="text-xs text-slate-400 mt-0.5">
          Verify physical stock availability for pending orders. Approve to release stock or Reject to route to Accountant.
        </p>
      </div>
    </div>
  </div>

  <% if (user.role !== 'storekeeper' && user.role !== 'manager') { %>
    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 text-xs text-amber-300 flex items-start space-x-3 shadow-lg">
      <i data-lucide="shield-alert" class="w-5 h-5 text-amber-400 shrink-0 mt-0.5"></i>
      <div>
        <p class="font-bold text-sm text-amber-400">Read-Only View Mode (<%= user.role.toUpperCase() %>)</p>
        <p class="mt-0.5 text-amber-200/80">You are viewing the physical stock dispatch queue. Stock approvals and dispatches are handled by Storekeeper and Manager accounts.</p>
      </div>
    </div>
  <% } %>

  <!-- Pending Review Queue Table -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden p-5 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider text-orange-400">
        1. Pending Dispatch Item Queue
      </h3>
      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-orange-500/20 text-orange-300">
        <%= pendingItems.length %> Items Awaiting Review
      </span>
    </div>

    <% if (pendingItems && pendingItems.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-[#222732] bg-[#181C24] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-3">Order No</th>
              <th class="py-3 px-3">Customer</th>
              <th class="py-3 px-3">Product Name</th>
              <th class="py-3 px-3 text-center">Requested Qty</th>
              <th class="py-3 px-3 text-center">Available Stock</th>
              <th class="py-3 px-3 text-center">Stock Feasibility</th>
              <th class="py-3 px-3 text-right">Storekeeper Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1D222B] text-xs">
            <% pendingItems.forEach(item => { %>
              <tr class="hover:bg-[#1A1E26] transition-colors">
                <td class="py-3.5 px-3 font-mono font-bold text-amber-400"><%= item.order_number %></td>
                <td class="py-3.5 px-3 font-bold text-white"><%= item.customer_name %></td>
                <td class="py-3.5 px-3 text-slate-200 font-medium"><%= item.product_name %></td>
                <td class="py-3.5 px-3 text-center font-mono font-bold text-amber-300">
                  <%= item.quantity %> <%= item.unit %>
                </td>
                <td class="py-3.5 px-3 text-center font-mono font-bold text-white">
                  <%= item.current_stock %> <%= item.unit %>
                </td>
                <td class="py-3.5 px-3 text-center">
                  <% if (item.current_stock >= item.quantity) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      Sufficient Stock
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-rose-500/10 text-rose-400 border border-rose-500/20">
                      Insufficient Stock
                    </span>
                  <% } %>
                </td>

                <td class="py-3.5 px-3 text-right">
                  <% if (user.role === 'storekeeper' || user.role === 'manager') { %>
                    <div class="flex items-center justify-end space-x-2">
                      <!-- Approve Button -->
                      <form action="/storekeeper/item-review" method="POST" class="inline">
                        <input type="hidden" name="item_id" value="<%= item.id %>">
                        <input type="hidden" name="action" value="approve">
                        <button type="submit" <%= item.current_stock < item.quantity ? 'disabled title="Stock insufficient"' : '' %>
                          class="px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-all disabled:opacity-40 disabled:cursor-not-allowed">
                          Approve & Release
                        </button>
                      </form>

                      <!-- Reject Modal Trigger -->
                      <button onclick="openRejectModal('<%= item.id %>', '<%= item.product_name.replace(/'/g, "\\'") %>', '<%= item.order_number %>')"
                        class="px-3 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/20 text-rose-400 font-bold text-xs transition-all">
                        Reject
                      </button>
                    </div>
                  <% } else { %>
                    <span class="text-[11px] font-medium text-slate-400 italic">
                      Awaiting Storekeeper
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <div class="p-8 text-center text-slate-500 text-xs">
              <i data-lucide="check-circle" class="w-8 h-8 text-emerald-500/50 mx-auto mb-2"></i>
              No pending order items awaiting storekeeper review.
            </div>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recently Reviewed History -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden p-5 space-y-3">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider text-slate-400">
      Recently Processed Reviews
    </h3>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[#222732] text-[10px] font-bold text-slate-500 uppercase">
            <th class="py-2 px-3">Order No</th>
            <th class="py-2 px-3">Product Item</th>
            <th class="py-2 px-3 text-center">Qty</th>
            <th class="py-2 px-3 text-center">Status</th>
            <th class="py-2 px-3 text-right">Rejection Reason / Note</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1D222B]">
          <% recentlyReviewed.forEach(r => { %>
            <tr>
              <td class="py-2.5 px-3 font-mono text-amber-400 font-bold"><%= r.order_number %></td>
              <td class="py-2.5 px-3 font-bold text-white"><%= r.product_name %></td>
              <td class="py-2.5 px-3 text-center font-mono text-slate-300"><%= r.quantity %></td>
              <td class="py-2.5 px-3 text-center">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= r.item_status === 'approved' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400' %>">
                  <%= r.item_status %>
                </span>
              </td>
              <td class="py-2.5 px-3 text-right text-slate-400 italic">
                <%= r.rejection_reason || 'Dispatched from main store' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Reject Reason Modal -->
<div id="rejectModal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#222732]">
      <h3 class="text-base font-bold text-white">Reject Dispatch Request</h3>
      <button onclick="document.getElementById('rejectModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/storekeeper/item-review" method="POST" class="space-y-4">
      <input type="hidden" id="rejectItemId" name="item_id">
      <input type="hidden" name="action" value="reject">

      <p class="text-xs text-slate-300" id="rejectModalText"></p>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Rejection Reason</label>
        <textarea name="rejection_reason" required rows="3" placeholder="e.g. Out of stock in main warehouse; requires Partner Shop procurement..."
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-rose-500"></textarea>
      </div>

      <div class="pt-2 flex justify-end space-x-3">
        <button type="button" onclick="document.getElementById('rejectModal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl bg-[#222834] text-xs font-bold text-slate-300">Cancel</button>
        <button type="submit"
          class="px-5 py-2 rounded-xl bg-rose-500 hover:bg-rose-600 text-white font-bold text-xs">Reject & Send to Accountant</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectModal(id, name, orderNum) {
    document.getElementById('rejectItemId').value = id;
    document.getElementById('rejectModalText').innerText = `Rejecting item "${name}" for Order ${orderNum}. This item will automatically route to the Accountant for Partner Shop procurement or zeroing.`;
    document.getElementById('rejectModal').classList.remove('hidden');
  }
</script>

<%- include('partials/footer') %>
