<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Header Banner -->
<section style="padding: 140px 0 60px; background: linear-gradient(to bottom, rgba(17, 17, 17, 0.8), var(--bg-primary)), url('/src/assets/images/film_akagera_1785877508167.jpg') center/cover; text-align: center; border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <span class="section-subtitle">AFRICAN CINEMA CATALOGUE</span>
    <h1 class="section-title gold-gradient-text" style="font-size: 3.2rem;">FILM PORTFOLIO</h1>
    <div class="section-divider"></div>
    <p style="max-width: 650px; margin: 20px auto 0; font-size: 1.05rem; color: var(--text-secondary);">
      Narrative feature films, short documentaries, poetic visual art pieces, and commercial cinema created by Wesley Studio in Rwanda.
    </p>
  </div>
</section>

<!-- Films Showcase Grid -->
<section class="section">
  <div class="container">
    <% if (films.length === 0) { %>
      <div style="text-align: center; padding: 60px 0; color: var(--text-secondary);">
        <i class="fa-solid fa-film gold-text" style="font-size: 3rem; margin-bottom: 16px; display: block;"></i>
        <h3>No films in catalogue yet.</h3>
        <p>Upload new films from the admin dashboard.</p>
      </div>
    <% } else { %>
      <div class="film-grid">
        <% films.forEach(film => { %>
          <div class="film-card">
            <div class="film-poster-wrap">
              <img src="<%= film.poster %>" alt="<%= film.title %>" class="film-poster">
              <div class="film-poster-overlay">
                <button class="play-btn" data-lightbox data-src="<%= film.video || 'https://www.youtube.com/embed/dQw4w9WgXcQ' %>" data-title="<%= film.title %>" data-desc="<%= film.genre %> • <%= film.duration %> • <%= film.year %>" data-is-video="true">
                  <i class="fa-solid fa-play"></i>
                </button>
              </div>
            </div>
            <div class="film-info">
              <div class="film-meta">
                <span><i class="fa-solid fa-clapperboard" style="margin-right: 4px;"></i> <%= film.genre %></span> • 
                <span><%= film.year %></span> • 
                <span><%= film.duration %></span>
              </div>
              <h3 class="film-title"><%= film.title %></h3>
              <p class="film-description"><%= film.description %></p>
              
              <% if (film.awards) { %>
                <div class="film-awards" style="margin-top: 12px;">
                  <i class="fa-solid fa-trophy" style="margin-right: 6px;"></i> <%= film.awards %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- Film Production Inquiry Section -->
<section class="section section-darker" style="text-align: center;">
  <div class="container">
    <span class="section-subtitle">COMMISSION & CO-PRODUCTION</span>
    <h2 class="section-title">COMMISSION A FILM OR DOCUMENTARY</h2>
    <p style="max-width: 650px; margin: 0 auto 30px; color: var(--text-secondary);">
      Wesley Studio provides full film production services in East Africa — scriptwriting, location scouting, casting, directing, cinematography, and post-production color grading.
    </p>
    <a href="/booking" class="btn btn-gold"><i class="fa-solid fa-tape"></i> Book Documentary or Film Production</a>
  </div>
</section>

<%- include('partials/footer') %>
