<%- include('partials/header', { title: 'Business Intelligence Reports — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6 p-4 sm:p-6">

  <!-- Page Heading -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h1 class="text-xl font-extrabold text-white font-display">Business Intelligence</h1>
      <p class="text-xs text-slate-400 mt-0.5">Revenue, profit, dead stock and receivables for <%= shop ? shop.name : 'your company' %></p>
    </div>
    <div class="flex items-center space-x-2 text-[11px] text-slate-400">
      <i data-lucide="info" class="w-3.5 h-3.5"></i>
      <span>Profit uses each line's recorded margin at time of sale.</span>
    </div>
  </div>

  <!-- KPI Tiles -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">30-Day Revenue</p>
      <p class="text-2xl font-black text-white font-mono mt-1.5">RWF <%= Number(kpis.revenue30).toLocaleString() %></p>
    </div>
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">30-Day Gross Profit</p>
      <p class="text-2xl font-black text-emerald-400 font-mono mt-1.5">RWF <%= Number(kpis.profit30).toLocaleString() %></p>
    </div>
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Receivables (Debts)</p>
      <p class="text-2xl font-black text-amber-400 font-mono mt-1.5">RWF <%= Number(kpis.receivables).toLocaleString() %></p>
    </div>
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5">
      <p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Capital in Dead Stock</p>
      <p class="text-2xl font-black text-rose-400 font-mono mt-1.5">RWF <%= Number(kpis.deadStockValue).toLocaleString() %></p>
    </div>
  </div>

  <!-- Charts -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5 shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center space-x-2">
        <i data-lucide="trending-up" class="w-4 h-4 text-amber-500"></i><span>Monthly Revenue vs Collections</span>
      </h3>
      <canvas id="chartRevenue" height="230"></canvas>
    </div>

    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5 shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center space-x-2">
        <i data-lucide="coins" class="w-4 h-4 text-emerald-400"></i><span>Monthly Gross Profit</span>
      </h3>
      <canvas id="chartProfit" height="230"></canvas>
    </div>

    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5 shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center space-x-2">
        <i data-lucide="flame" class="w-4 h-4 text-amber-500"></i><span>Top Sellers — Last 90 Days</span>
      </h3>
      <% if (topProducts.length === 0) { %>
        <p class="text-xs text-slate-400 py-8 text-center">No sales recorded yet.</p>
      <% } else { %>
        <canvas id="chartTop" height="240"></canvas>
      <% } %>
    </div>

    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5 shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center space-x-2">
        <i data-lucide="ghost" class="w-4 h-4 text-rose-400"></i><span>Dead Stock by Value (90+ days unsold)</span>
      </h3>
      <% if (deadStock.length === 0) { %>
        <p class="text-xs text-slate-400 py-8 text-center">Excellent — no dead stock detected!</p>
      <% } else { %>
        <canvas id="chartDead" height="240"></canvas>
      <% } %>
    </div>
  </div>

  <!-- Tables -->
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl overflow-hidden shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider p-5 pb-3 flex items-center space-x-2">
        <i data-lucide="hand-coins" class="w-4 h-4 text-amber-500"></i><span>Highest Debtors — Follow Up</span>
      </h3>
      <table class="w-full text-left">
        <thead>
          <tr class="border-y border-[var(--c-border)] text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-2.5 px-5">Customer</th>
            <th class="py-2.5 px-3">Phone</th>
            <th class="py-2.5 px-5 text-right">Owes (RWF)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--c-divide)] text-xs">
          <% if (debtors.length === 0) { %>
            <tr><td colspan="3" class="py-6 text-center text-slate-400">No outstanding customer debts.</td></tr>
          <% } %>
          <% debtors.forEach(d => { %>
            <tr class="hover:bg-[var(--c-input)] transition-colors">
              <td class="py-3 px-5 font-bold text-white"><%= d.name %></td>
              <td class="py-3 px-3 text-slate-300 font-mono"><%= d.phone %></td>
              <td class="py-3 px-5 text-right font-mono font-black text-amber-400"><%= Number(d.credit_balance).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl overflow-hidden shadow-xl">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider p-5 pb-3 flex items-center space-x-2">
        <i data-lucide="package-x" class="w-4 h-4 text-rose-400"></i><span>Dead Stock Items — Consider Promotions</span>
      </h3>
      <table class="w-full text-left">
        <thead>
          <tr class="border-y border-[var(--c-border)] text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-2.5 px-5">Product</th>
            <th class="py-2.5 px-3 text-center">Qty</th>
            <th class="py-2.5 px-5 text-right">Tied Capital (RWF)</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--c-divide)] text-xs">
          <% if (deadStock.length === 0) { %>
            <tr><td colspan="3" class="py-6 text-center text-slate-400">Everything on your shelves is moving.</td></tr>
          <% } %>
          <% deadStock.forEach(d => { %>
            <tr class="hover:bg-[var(--c-input)] transition-colors">
              <td class="py-3 px-5">
                <p class="font-bold text-white"><%= d.name %></p>
                <p class="text-[10px] text-slate-400"><%= d.category %></p>
              </td>
              <td class="py-3 px-3 text-center font-mono text-slate-300"><%= d.quantity %></td>
              <td class="py-3 px-5 text-right font-mono font-black text-rose-400"><%= Number(d.tied_value).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  const chartFont = { family: "'Plus Jakarta Sans', sans-serif", size: 11 };
  const gridColor = getComputedStyle(document.documentElement).getPropertyValue('--c-divide').trim() || '#1D222B';
  const textColor = '#94a3b8';

  // Monthly Revenue vs Collections
  new Chart(document.getElementById('chartRevenue'), {
    type: 'bar',
    data: {
      labels: <%- JSON.stringify(monthly.map(m => m.ym)) %>,
      datasets: [
        { label: 'Revenue', data: <%- JSON.stringify(monthly.map(m => Number(m.revenue))) %>, backgroundColor: 'rgba(212,175,55,0.75)', borderRadius: 6 },
        { label: 'Collected', data: <%- JSON.stringify(monthly.map(m => Number(m.collected))) %>, backgroundColor: 'rgba(52,211,153,0.7)', borderRadius: 6 }
      ]
    },
    options: {
      responsive: true,
      plugins: { legend: { labels: { color: textColor, font: chartFont } } },
      scales: {
        x: { ticks: { color: textColor, font: chartFont }, grid: { color: gridColor } },
        y: { ticks: { color: textColor, font: chartFont, callback: v => (v/1000) + 'k' }, grid: { color: gridColor } }
      }
    }
  });

  // Monthly Profit
  new Chart(document.getElementById('chartProfit'), {
    type: 'line',
    data: {
      labels: <%- JSON.stringify(monthlyProfit.map(m => m.ym)) %>,
      datasets: [{
        label: 'Gross Profit',
        data: <%- JSON.stringify(monthlyProfit.map(m => Number(m.profit))) %>,
        borderColor: '#34d399', backgroundColor: 'rgba(52,211,153,0.15)',
        fill: true, tension: 0.35, pointBackgroundColor: '#34d399'
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { labels: { color: textColor, font: chartFont } } },
      scales: {
        x: { ticks: { color: textColor, font: chartFont }, grid: { color: gridColor } },
        y: { ticks: { color: textColor, font: chartFont, callback: v => (v/1000) + 'k' }, grid: { color: gridColor } }
      }
    }
  });

  <% if (topProducts.length > 0) { %>
  // Top Sellers horizontal bars
  new Chart(document.getElementById('chartTop'), {
    type: 'bar',
    data: {
      labels: <%- JSON.stringify(topProducts.map(p => p.name.length > 26 ? p.name.slice(0, 25) + '…' : p.name)) %>,
      datasets: [{ label: 'Units sold', data: <%- JSON.stringify(topProducts.map(p => Number(p.qty))) %>, backgroundColor: 'rgba(212,175,55,0.8)', borderRadius: 6 }]
    },
    options: {
      indexAxis: 'y', responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { color: textColor, font: chartFont }, grid: { color: gridColor } },
        y: { ticks: { color: textColor, font: chartFont }, grid: { display: false } }
      }
    }
  });
  <% } %>

  <% if (deadStock.length > 0) { %>
  // Dead stock doughnut
  new Chart(document.getElementById('chartDead'), {
    type: 'doughnut',
    data: {
      labels: <%- JSON.stringify(deadStock.map(d => d.name.length > 22 ? d.name.slice(0, 21) + '…' : d.name)) %>,
      datasets: [{
        data: <%- JSON.stringify(deadStock.map(d => Number(d.tied_value))) %>,
        backgroundColor: ['#f43f5e','#fb923c','#facc15','#a3e635','#34d399','#38bdf8','#818cf8','#c084fc','#f472b6','#94a3b8']
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { position: 'right', labels: { color: textColor, font: chartFont, boxWidth: 12 } } }
    }
  });
  <% } %>
</script>

<%- include('partials/footer') %>
