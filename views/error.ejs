<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'System Error — VectOS' %></title>
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0D0F12">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="h-full flex flex-col font-sans bg-[#0D0F12] text-slate-200 antialiased">

  <main class="flex-1 flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 shadow-xl shadow-amber-500/20 mb-4">
        <i data-lucide="alert-triangle" class="w-8 h-8"></i>
      </div>
      <p class="text-xs font-semibold text-amber-400 uppercase tracking-widest mb-2">VectOS Platform</p>
      <h1 class="text-3xl font-extrabold text-white tracking-tight font-display mb-3"><%= typeof title !== 'undefined' ? title : 'System Error' %></h1>
      <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-6 shadow-2xl space-y-4">
        <p class="text-sm text-slate-300 leading-relaxed"><%= typeof message !== 'undefined' ? message : 'An unexpected operational error occurred.' %></p>
        <% if (typeof path !== 'undefined' && path) { %>
          <p class="text-[11px] text-slate-500 font-mono">Requested path: <%= path %></p>
        <% } %>
        <div class="flex items-center justify-center gap-3 pt-1">
          <a href="/" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 text-sm font-bold shadow-lg transition-all">
            <i data-lucide="home" class="w-4 h-4"></i> Go Home
          </a>
          <a href="/login" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-[#2B313E] bg-[#1A1E26] hover:bg-[#222730] text-slate-200 text-sm font-semibold transition-all">
            <i data-lucide="log-in" class="w-4 h-4"></i> Sign In
          </a>
        </div>
      </div>
      <p class="mt-6 text-[11px] text-slate-600">Quincaille IOMS — Kigali Construction ERP • Powered by VectOS</p>
    </div>
  </main>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    });
  </script>
</body>
</html>
