<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delivery Note <%= order.order_number %> — <%= shopInfo ? shopInfo.name : 'VectOS' %></title>
  <link rel="stylesheet" href="/styles/tailwind.css">
  <style>
    @media print {
      .no-print { display: none !important; }
      body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      @page { margin: 12mm; size: A4; }
    }
    body { background: #f8fafc; }
    @media print { body { background: white; } }
  </style>
</head>
<body class="text-slate-800 antialiased">
  <div class="no-print max-w-3xl mx-auto px-4 pt-6 flex justify-between items-center">
    <a href="/orders/<%= order.id %>" class="text-sm text-slate-600 hover:text-slate-900">&larr; Back to Order</a>
    <button onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow">Print Delivery Note</button>
  </div>

  <div class="max-w-3xl mx-auto bg-white my-6 rounded-2xl shadow-xl overflow-hidden print:shadow-none print:rounded-none print:my-0">
    <div class="px-8 py-6 border-b-2 border-slate-900 flex justify-between items-start gap-4">
      <div>
        <h1 class="text-xl font-black uppercase tracking-wide"><%= shopInfo ? shopInfo.name : 'VectOS Depot' %></h1>
        <p class="text-xs text-slate-500 mt-1"><%= shopInfo ? shopInfo.location : 'Kigali, Rwanda' %> • <%= shopInfo ? shopInfo.phone : '' %></p>
        <% if (shopInfo && shopInfo.tin_number) { %><p class="text-xs font-mono text-slate-600">TIN: <%= shopInfo.tin_number %></p><% } %>
      </div>
      <div class="text-right">
        <p class="text-xs uppercase tracking-widest text-slate-500">Delivery Note</p>
        <p class="text-lg font-mono font-black mt-1"><%= order.order_number %></p>
        <p class="text-xs text-slate-500"><%= new Date(order.created_at).toLocaleDateString('en-GB') %></p>
        <p class="text-[11px] font-bold uppercase tracking-widest mt-1 <%= order.fulfillment_status==='completed'?'text-emerald-600':'text-amber-600' %>"><%= order.fulfillment_status %></p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-0 divide-x divide-slate-100 border-b border-slate-200">
      <div class="px-8 py-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Deliver To</p>
        <p class="text-sm font-bold text-slate-900 mt-1"><%= order.customer_name %></p>
        <p class="text-xs text-slate-600"><%= order.customer_phone %><% if(order.customer_id_number){ %> • ID: <%= order.customer_id_number %><% } %></p>
        <p class="text-xs text-slate-500"><%= order.customer_address||'' %></p>
      </div>
      <div class="px-8 py-4">
        <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Dispatch Info</p>
        <p class="text-xs text-slate-600 mt-1">Salesperson: <span class="font-semibold text-slate-900"><%= order.salesperson_name %></span></p>
        <p class="text-xs text-slate-500">Order: <%= order.order_number %> • <%= order.fulfillment_status %></p>
        <% if(order.notes){ %><p class="text-xs italic text-slate-500 mt-1">"<%= order.notes %>"</p><% } %>
        <p class="text-[10px] font-mono text-amber-600 mt-2">RRA Audit Safe — Quantities Only, No Prices</p>
      </div>
    </div>

    <div class="px-8 py-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b-2 border-slate-900 text-[11px] uppercase tracking-widest text-slate-500">
            <th class="text-left py-2.5">#</th>
            <th class="text-left py-2.5">Product</th>
            <th class="text-left py-2.5">SKU</th>
            <th class="text-center py-2.5">Qty</th>
            <th class="text-center py-2.5">Unit</th>
            <th class="text-center py-2.5">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% items.forEach((it, idx)=>{ %>
            <tr>
              <td class="py-3 text-xs font-mono text-slate-400"><%= idx+1 %></td>
              <td class="py-3 font-semibold text-slate-900"><%= it.product_name %></td>
              <td class="py-3 font-mono text-xs text-slate-500"><%= it.product_sku||'-' %></td>
              <td class="py-3 text-center font-mono font-black text-lg"><%= it.quantity %></td>
              <td class="py-3 text-center text-xs"><%= it.product_unit||'pcs' %></td>
              <td class="py-3 text-center"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase border <%= it.item_status==='approved'?'bg-emerald-50 text-emerald-700 border-emerald-200': it.item_status==='partner_fulfilled'?'bg-blue-50 text-blue-700 border-blue-200':'bg-amber-50 text-amber-700 border-amber-200' %>"><%= it.item_status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <div class="mt-6 flex justify-between text-sm border-t border-slate-900 pt-4">
        <span class="text-slate-500">Total Items</span>
        <span class="font-mono font-black"><%= items.reduce((a,b)=>a+Number(b.quantity||0),0) %> units • <%= items.length %> lines</span>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-6 px-8 py-8 border-t border-slate-200 text-center">
      <div><div class="h-12 border-b border-slate-300 mb-2"></div><p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Storekeeper</p><p class="text-xs text-slate-400">Signature & Date</p></div>
      <div><div class="h-12 border-b border-slate-300 mb-2"></div><p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Customer</p><p class="text-xs text-slate-400">Received in good condition</p></div>
      <div><div class="h-12 border-b border-slate-300 mb-2"></div><p class="text-[11px] font-bold uppercase tracking-widest text-slate-500">Driver / Transport</p><p class="text-xs text-slate-400">Signature & Date</p></div>
    </div>

    <div class="px-8 py-4 bg-amber-50 border-t border-amber-100 text-center">
      <p class="text-xs text-amber-800"><%= shopInfo && shopInfo.receipt_footer_text ? shopInfo.receipt_footer_text : 'Goods once sold in good condition are not returnable. Please verify quantities upon receipt.' %></p>
      <p class="text-[10px] font-mono text-slate-400 mt-2">VectOS — Depot ERP • <%= order.order_number %> • <%= new Date().toLocaleString('en-GB') %></p>
    </div>
  </div>
</body>
</html>
