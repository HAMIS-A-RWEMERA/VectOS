<%- include('partials/header', { title: 'Staff Roles & Granular Access Matrix — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6 max-w-7xl mx-auto">
  <!-- Header Banner -->
  <div class="pb-4 border-b border-[var(--c-border)] flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
          Staff Permissions & Role Checklists
        </h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <%= shop ? shop.name : 'Store' %> Matrix
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Configure employee capabilities per account. Tick or untick rights depending on daily shift duties, cashiering, or warehouse responsibilities.
      </p>
    </div>

    <div class="flex items-center space-x-3">
      <button onclick="openAddUserModal()"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        <span>Add Staff Account</span>
      </button>
    </div>
  </div>

  <% if (typeof msg !== 'undefined' && msg) { %>
    <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-xs flex items-center space-x-2">
      <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
      <span><%= msg %></span>
    </div>
  <% } %>

  <!-- Permissions Explainer Box -->
  <div class="p-4 bg-[var(--c-panel2)] border border-[var(--c-border)] rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 flex-shrink-0">
        <i data-lucide="sliders-horizontal" class="w-5 h-5"></i>
      </div>
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider">Dynamic Role Delegation</h3>
        <p class="text-[11px] text-slate-400">
          No two hardware shops operate identically. Grant specific workers cashiering rights, hide cost/buying prices from counter clerks, or delegate out-of-stock sourcing with individual checkboxes.
        </p>
      </div>
    </div>
  </div>

  <!-- Users Table with Granular Checklists -->
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[var(--c-border)] bg-[var(--c-panel2)] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4">Staff Member</th>
            <th class="py-3.5 px-4">Job Title / Role</th>
            <th class="py-3.5 px-4">Active Capabilities & Checklists</th>
            <th class="py-3.5 px-4 text-center">Status</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--c-divide)]">
          <% users.forEach(u => { %>
            <tr class="hover:bg-[var(--c-input)] transition-colors">
              <!-- Staff Info -->
              <td class="py-4 px-4">
                <div class="flex items-center space-x-3">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-tr <%= u.role === 'manager' || u.role === 'superadmin' ? 'from-amber-500 to-amber-700' : 'from-slate-700 to-slate-800' %> flex items-center justify-center text-white font-bold text-xs">
                    <%= u.name.charAt(0).toUpperCase() %>
                  </div>
                  <div>
                    <div class="font-bold text-white flex items-center space-x-2">
                      <span><%= u.name %></span>
                      <% if (u.id === user.id) { %>
                        <span class="text-[10px] bg-amber-500/20 text-amber-300 px-1.5 py-0.2 rounded font-semibold">You</span>
                      <% } %>
                    </div>
                    <div class="text-[11px] text-slate-400 font-mono"><%= u.email %> • <%= u.phone || 'No Phone' %></div>
                  </div>
                </div>
              </td>

              <!-- Job Title -->
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-200"><%= u.job_title || u.role %></div>
                <span class="inline-block mt-0.5 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider <%= u.role === 'manager' || u.role === 'superadmin' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-slate-800 text-slate-300 border border-slate-700' %>">
                  <%= u.role %>
                </span>
              </td>

              <!-- Granted Permissions Badges -->
              <td class="py-4 px-4 max-w-md">
                <% if (u.role === 'manager' || u.role === 'superadmin') { %>
                  <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                    <span>Full Depot Administrator (All Capabilities Enabled)</span>
                  </span>
                <% } else { %>
                  <div class="flex flex-wrap gap-1.5">
                    <% if (u.can_create_orders) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">✓ Orders & Sales</span>
                    <% } %>
                    <% if (u.can_process_payments) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">✓ Cashier Payments</span>
                    <% } %>
                    <% if (u.can_release_stock) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">✓ Stock Dispatch</span>
                    <% } %>
                    <% if (u.can_manage_stock) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">✓ Inventory Mgmt</span>
                    <% } %>
                    <% if (u.can_import_export_stock) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">✓ Excel Bulk Import</span>
                    <% } %>
                    <% if (u.can_partner_borrow) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">✓ Partner Sourcing</span>
                    <% } %>
                    <% if (u.can_view_buying_prices) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">✓ View Cost Margins</span>
                    <% } %>
                    <% if (u.can_give_discounts) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">✓ Custom Discounts</span>
                    <% } %>
                    <% if (u.can_view_reports) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">✓ Reports & Analytics</span>
                    <% } %>
                    <% if (u.can_print_full_receipt) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-teal-500/10 text-teal-400 border border-teal-500/20">✓ Print Receipts</span>
                    <% } %>
                    <% if (u.can_print_delivery_note) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-yellow-500/10 text-yellow-400 border border-yellow-500/20">✓ Delivery Slips</span>
                    <% } %>
                    <% if (u.can_manage_customers) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-700 text-slate-300">✓ Customers</span>
                    <% } %>
                    <% if (u.can_manage_partners) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-700 text-slate-300">✓ Partners</span>
                    <% } %>
                    <% if (u.can_void_orders) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">✓ Void Orders</span>
                    <% } %>
                    <% if (u.can_edit_company_settings) { %>
                      <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">✓ Edit Company Info</span>
                    <% } %>
                  </div>
                <% } %>
              </td>

              <!-- Status -->
              <td class="py-4 px-4 text-center">
                <% if (!u.is_active) { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    Deactivated
                  </span>
                <% } else if (u.activation_status === 'pending_approval') { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">
                    Pending Activation
                  </span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Active
                  </span>
                <% } %>
              </td>

              <!-- Actions -->
              <td class="py-4 px-4 text-right">
                <div class="flex items-center justify-end space-x-2">
                  <button type="button" 
                    onclick='openEditUserModal(<%- JSON.stringify(u) %>)'
                    class="px-2.5 py-1.5 rounded-lg bg-[var(--c-chip)] hover:bg-[var(--c-border2)] text-slate-200 font-semibold text-xs border border-[var(--c-border2)] transition-all flex items-center space-x-1 cursor-pointer">
                    <i data-lucide="edit" class="w-3.5 h-3.5"></i>
                    <span>Edit Checklists</span>
                  </button>

                  <% if (u.id !== user.id && u.role !== 'superadmin' && (u.role === 'employee' || user.role === 'superadmin')) { %>
                    <form action="/users/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Are you sure you want to deactivate/remove <%= u.name %>?')" class="inline">
                      <button type="submit" class="p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/20 transition-all cursor-pointer" title="Deactivate / Remove">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add User Modal with Permission Checkboxes -->
<div id="addUserModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-3xl p-6 space-y-5 shadow-2xl my-8">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <div>
        <h3 class="text-base font-bold text-white">Create New Employee Account</h3>
        <p class="text-xs text-slate-400">Configure credentials and assign operational permission checkboxes.</p>
      </div>
      <button onclick="closeAddUserModal()" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Quick Presets -->
    <div class="p-3 bg-[var(--c-panel2)] border border-[var(--c-border)] rounded-xl flex flex-wrap items-center gap-2">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mr-1">Quick Presets:</span>
      <button type="button" onclick="applyPreset('sales')" class="px-2 py-1 rounded bg-[var(--c-btn)] hover:bg-blue-600/30 text-blue-400 text-[11px] font-semibold transition-all">Salesperson</button>
      <button type="button" onclick="applyPreset('cashier')" class="px-2 py-1 rounded bg-[var(--c-btn)] hover:bg-emerald-600/30 text-emerald-400 text-[11px] font-semibold transition-all">Cashier / Accountant</button>
      <button type="button" onclick="applyPreset('storekeeper')" class="px-2 py-1 rounded bg-[var(--c-btn)] hover:bg-amber-600/30 text-amber-400 text-[11px] font-semibold transition-all">Warehouse Storekeeper</button>
      <button type="button" onclick="applyPreset('all')" class="px-2 py-1 rounded bg-[var(--c-btn)] hover:bg-purple-600/30 text-purple-400 text-[11px] font-semibold transition-all">All-Rounder Operator</button>
    </div>

    <form action="/users/add" method="POST" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Full Name *</label>
          <input type="text" name="name" required placeholder="e.g. Marie-Claire Umutoni"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Work Email (Login Username) *</label>
          <input type="email" name="email" required placeholder="e.g. staff@yourstore.rw"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Job Title</label>
          <input type="text" id="add_job_title" name="job_title" placeholder="e.g. Sales & Counter Cashier"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Contact Phone</label>
          <input type="text" name="phone" placeholder="+250 788 000 000"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div class="md:col-span-2">
          <label class="block font-semibold text-slate-300 mb-1">Account Password *</label>
          <input type="password" name="password" required placeholder="••••••••"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>
      </div>

      <!-- Granular Role Checklists Matrix -->
      <div class="pt-2">
        <label class="block text-xs font-bold text-amber-400 uppercase tracking-wider mb-2 flex items-center space-x-1.5">
          <i data-lucide="check-square" class="w-4 h-4"></i>
          <span>Assign Capabilities & Permission Ticks</span>
        </label>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 bg-[var(--c-panel)] border border-[var(--c-border)] rounded-xl">
          
          <!-- Sales & Orders -->
          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_create_orders" name="can_create_orders" checked class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Create Orders & Price Negotiation</span>
              <p class="text-[10px] text-slate-400">Can register clients, draft orders, negotiate unit prices.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_give_discounts" name="can_give_discounts" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Special Discounts Authorization</span>
              <p class="text-[10px] text-slate-400">Authority to apply custom contractor discount rates.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_process_payments" name="can_process_payments" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Process Payments / Cashier</span>
              <p class="text-[10px] text-slate-400">Record MoMo, cash, bank payments, and clear client debt.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_release_stock" name="can_release_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Stock Release & Storekeeper Review</span>
              <p class="text-[10px] text-slate-400">Approve order item dispatch or reject out-of-stock items.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_manage_stock" name="can_manage_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Catalog & Inventory Stock</span>
              <p class="text-[10px] text-slate-400">Add products, edit stock thresholds, and adjust inventory.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_import_export_stock" name="can_import_export_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Bulk Excel / CSV Import & Export</span>
              <p class="text-[10px] text-slate-400">Upload bulk product spreadsheets and export stock data.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_partner_borrow" name="can_partner_borrow" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Partner Shop Sourcing / Borrowing</span>
              <p class="text-[10px] text-slate-400">Resolve rejected items by procuring from partner stores.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_view_buying_prices" name="can_view_buying_prices" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">View Purchase Costs & Wholesale Margins</span>
              <p class="text-[10px] text-slate-400">Reveal cost price (uncheck to hide supplier costs from clerks).</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_view_reports" name="can_view_reports" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">View Financial Reports & Analytics</span>
              <p class="text-[10px] text-slate-400">Access profit breakdown, salesperson stats, debt totals.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_print_full_receipt" name="can_print_full_receipt" checked class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Print Financial Receipts (RWF Prices)</span>
              <p class="text-[10px] text-slate-400">Generate customer receipts containing monetary amounts.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_print_delivery_note" name="can_print_delivery_note" checked class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Print Delivery Notes (Quantities Only)</span>
              <p class="text-[10px] text-slate-400">Logistics dispatch slips without prices (for drivers & RRA).</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_manage_customers" name="can_manage_customers" checked class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Customer Directory & Credit</span>
              <p class="text-[10px] text-slate-400">Create customer profiles and view credit balances.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_manage_partners" name="can_manage_partners" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Partner Suppliers Directory</span>
              <p class="text-[10px] text-slate-400">Add and manage partner hardware shops in the network.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_void_orders" name="can_void_orders" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Void / Cancel Sales Orders</span>
              <p class="text-[10px] text-slate-400">Cancel erroneous orders and restock reserved items.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="add_can_edit_company_settings" name="can_edit_company_settings" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Edit Company Information & TIN</span>
              <p class="text-[10px] text-slate-400">Update depot header details and phone numbers.</p>
            </div>
          </label>

        </div>
      </div>

      <div class="pt-3 flex justify-end space-x-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="closeAddUserModal()"
          class="px-4 py-2.5 rounded-xl bg-[var(--c-btn)] font-bold text-slate-300 hover:bg-[var(--c-border2)] cursor-pointer">Cancel</button>
        <button type="submit"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 text-slate-950 font-bold hover:from-amber-300 hover:to-amber-500 shadow-md shadow-amber-500/20 cursor-pointer">Create Account</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit User & Dynamic Permissions Modal -->
<div id="editUserModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-3xl p-6 space-y-5 shadow-2xl my-8">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <div>
        <h3 class="text-base font-bold text-white">Edit Permissions: <span id="edit_user_name_display" class="text-amber-400"></span></h3>
        <p class="text-xs text-slate-400">Update capabilities and operational checklists on the fly.</p>
      </div>
      <button onclick="closeEditUserModal()" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="editUserForm" action="" method="POST" class="space-y-4 text-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        <div>
          <label class="block font-semibold text-slate-300 mb-1">Full Name</label>
          <input type="text" id="edit_name" name="name" required
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Email Address</label>
          <input type="email" id="edit_email" name="email" required
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Job Title</label>
          <input type="text" id="edit_job_title" name="job_title"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">Phone Number</label>
          <input type="text" id="edit_phone" name="phone"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div>
          <label class="block font-semibold text-slate-300 mb-1">New Password (leave blank to keep current)</label>
          <input type="password" name="password" placeholder="••••••••"
            class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-500">
        </div>

        <div class="flex items-center pt-6">
          <label class="flex items-center space-x-2.5 cursor-pointer">
            <input type="checkbox" id="edit_is_active" name="is_active" class="rounded border-slate-700 text-emerald-500 focus:ring-emerald-500">
            <span class="font-bold text-white">Account Active & Enabled</span>
          </label>
        </div>
      </div>

      <!-- Permission Checkboxes Matrix -->
      <div class="pt-2">
        <div class="flex items-center justify-between mb-2">
          <label class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center space-x-1.5">
            <i data-lucide="shield" class="w-4 h-4"></i>
            <span>Assigned Checklists & Capabilities</span>
          </label>
          <div class="flex space-x-2">
            <button type="button" onclick="toggleAllEdit(true)" class="text-[11px] text-amber-400 hover:underline">Select All</button>
            <span class="text-slate-600">•</span>
            <button type="button" onclick="toggleAllEdit(false)" class="text-[11px] text-slate-400 hover:underline">Deselect All</button>
          </div>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 bg-[var(--c-panel)] border border-[var(--c-border)] rounded-xl">
          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_create_orders" name="can_create_orders" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Create Orders & Price Negotiation</span>
              <p class="text-[10px] text-slate-400">Can register clients, draft orders, negotiate prices.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_give_discounts" name="can_give_discounts" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Special Discounts Authorization</span>
              <p class="text-[10px] text-slate-400">Authority to apply custom contractor discount rates.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_process_payments" name="can_process_payments" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Process Payments / Cashier</span>
              <p class="text-[10px] text-slate-400">Can record payments, verify receipts, clear debt.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_release_stock" name="can_release_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Stock Release & Storekeeper Review</span>
              <p class="text-[10px] text-slate-400">Can approve item dispatch or reject items.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_manage_stock" name="can_manage_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Catalog & Inventory Stock</span>
              <p class="text-[10px] text-slate-400">Can add products, adjust stock, modify items.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_import_export_stock" name="can_import_export_stock" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Bulk Excel / CSV Import & Export</span>
              <p class="text-[10px] text-slate-400">Upload bulk product spreadsheets and export stock data.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_partner_borrow" name="can_partner_borrow" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Partner Shop Sourcing / Borrowing</span>
              <p class="text-[10px] text-slate-400">Can resolve out-of-stock via partner hardware stores.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_view_buying_prices" name="can_view_buying_prices" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">View Purchase Costs & Margins</span>
              <p class="text-[10px] text-slate-400">Reveal cost price (uncheck to hide supplier costs).</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_view_reports" name="can_view_reports" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">View Financial Reports & Margins</span>
              <p class="text-[10px] text-slate-400">Can access profit analysis and salesperson totals.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_print_full_receipt" name="can_print_full_receipt" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Print Financial Receipts (RWF Prices)</span>
              <p class="text-[10px] text-slate-400">Can print customer receipts with money/prices.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_print_delivery_note" name="can_print_delivery_note" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Print Delivery Notes (Quantities Only)</span>
              <p class="text-[10px] text-slate-400">Can print logistics delivery slips without prices.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_manage_customers" name="can_manage_customers" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Customers & Credit Lines</span>
              <p class="text-[10px] text-slate-400">Can add clients and manage contact records.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_manage_partners" name="can_manage_partners" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Manage Partner Suppliers Directory</span>
              <p class="text-[10px] text-slate-400">Can manage partner hardware directory.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_void_orders" name="can_void_orders" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Void / Cancel Sales Orders</span>
              <p class="text-[10px] text-slate-400">Cancel erroneous orders and restock items.</p>
            </div>
          </label>

          <label class="flex items-start space-x-2.5 cursor-pointer hover:text-white text-slate-300">
            <input type="checkbox" id="edit_can_edit_company_settings" name="can_edit_company_settings" class="mt-0.5 rounded border-slate-700 text-amber-500 focus:ring-amber-500">
            <div>
              <span class="font-semibold text-white">Edit Company Information & TIN</span>
              <p class="text-[10px] text-slate-400">Update depot header details and contact info.</p>
            </div>
          </label>

        </div>
      </div>

      <div class="pt-3 flex justify-end space-x-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="closeEditUserModal()"
          class="px-4 py-2.5 rounded-xl bg-[var(--c-btn)] font-bold text-slate-300 hover:bg-[var(--c-border2)] cursor-pointer">Cancel</button>
        <button type="submit"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 text-slate-950 font-bold hover:from-amber-300 hover:to-amber-500 shadow-md shadow-amber-500/20 cursor-pointer">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddUserModal() {
    document.getElementById('addUserModal').classList.remove('hidden');
  }
  function closeAddUserModal() {
    document.getElementById('addUserModal').classList.add('hidden');
  }
  function openEditUserModal(u) {
    document.getElementById('editUserForm').action = '/users/edit/' + u.id;
    document.getElementById('edit_user_name_display').textContent = u.name;
    document.getElementById('edit_name').value = u.name;
    document.getElementById('edit_email').value = u.email;
    document.getElementById('edit_job_title').value = u.job_title || u.role;
    document.getElementById('edit_phone').value = u.phone || '';
    document.getElementById('edit_is_active').checked = !!u.is_active;

    document.getElementById('edit_can_create_orders').checked = !!u.can_create_orders;
    document.getElementById('edit_can_give_discounts').checked = !!u.can_give_discounts;
    document.getElementById('edit_can_process_payments').checked = !!u.can_process_payments;
    document.getElementById('edit_can_release_stock').checked = !!u.can_release_stock;
    document.getElementById('edit_can_manage_stock').checked = !!u.can_manage_stock;
    document.getElementById('edit_can_import_export_stock').checked = !!u.can_import_export_stock;
    document.getElementById('edit_can_partner_borrow').checked = !!u.can_partner_borrow;
    document.getElementById('edit_can_view_buying_prices').checked = !!u.can_view_buying_prices;
    document.getElementById('edit_can_view_reports').checked = !!u.can_view_reports;
    document.getElementById('edit_can_print_full_receipt').checked = !!u.can_print_full_receipt;
    document.getElementById('edit_can_print_delivery_note').checked = !!u.can_print_delivery_note;
    document.getElementById('edit_can_manage_customers').checked = !!u.can_manage_customers;
    document.getElementById('edit_can_manage_partners').checked = !!u.can_manage_partners;
    document.getElementById('edit_can_void_orders').checked = !!u.can_void_orders;
    document.getElementById('edit_can_edit_company_settings').checked = !!u.can_edit_company_settings;

    document.getElementById('editUserModal').classList.remove('hidden');
  }
  function closeEditUserModal() {
    document.getElementById('editUserModal').classList.add('hidden');
  }

  function toggleAllEdit(val) {
    const ids = [
      'edit_can_create_orders', 'edit_can_give_discounts', 'edit_can_process_payments', 'edit_can_release_stock',
      'edit_can_manage_stock', 'edit_can_import_export_stock', 'edit_can_partner_borrow', 'edit_can_view_buying_prices',
      'edit_can_view_reports', 'edit_can_print_full_receipt', 'edit_can_print_delivery_note', 'edit_can_manage_customers',
      'edit_can_manage_partners', 'edit_can_void_orders', 'edit_can_edit_company_settings'
    ];
    ids.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.checked = val;
    });
  }

  function applyPreset(preset) {
    const check = (id, val) => {
      const el = document.getElementById(id);
      if (el) el.checked = val;
    };
    const jt = document.getElementById('add_job_title');

    if (preset === 'sales') {
      if (jt) jt.value = 'Sales Representative';
      check('add_can_create_orders', true);
      check('add_can_give_discounts', true);
      check('add_can_process_payments', false);
      check('add_can_release_stock', false);
      check('add_can_manage_stock', false);
      check('add_can_import_export_stock', false);
      check('add_can_partner_borrow', false);
      check('add_can_view_buying_prices', false);
      check('add_can_view_reports', false);
      check('add_can_print_full_receipt', true);
      check('add_can_print_delivery_note', true);
      check('add_can_manage_customers', true);
      check('add_can_manage_partners', false);
      check('add_can_void_orders', false);
      check('add_can_edit_company_settings', false);
    } else if (preset === 'cashier') {
      if (jt) jt.value = 'Cashier / Accountant';
      check('add_can_create_orders', false);
      check('add_can_give_discounts', false);
      check('add_can_process_payments', true);
      check('add_can_release_stock', false);
      check('add_can_manage_stock', false);
      check('add_can_import_export_stock', false);
      check('add_can_partner_borrow', true);
      check('add_can_view_buying_prices', true);
      check('add_can_view_reports', true);
      check('add_can_print_full_receipt', true);
      check('add_can_print_delivery_note', true);
      check('add_can_manage_customers', true);
      check('add_can_manage_partners', true);
      check('add_can_void_orders', true);
      check('add_can_edit_company_settings', false);
    } else if (preset === 'storekeeper') {
      if (jt) jt.value = 'Storekeeper / Warehouse Officer';
      check('add_can_create_orders', false);
      check('add_can_give_discounts', false);
      check('add_can_process_payments', false);
      check('add_can_release_stock', true);
      check('add_can_manage_stock', true);
      check('add_can_import_export_stock', true);
      check('add_can_partner_borrow', false);
      check('add_can_view_buying_prices', false);
      check('add_can_view_reports', false);
      check('add_can_print_full_receipt', false);
      check('add_can_print_delivery_note', true);
      check('add_can_manage_customers', false);
      check('add_can_manage_partners', false);
      check('add_can_void_orders', false);
      check('add_can_edit_company_settings', false);
    } else if (preset === 'all') {
      if (jt) jt.value = 'All-Rounder Store Operator';
      [
        'add_can_create_orders', 'add_can_give_discounts', 'add_can_process_payments', 'add_can_release_stock',
        'add_can_manage_stock', 'add_can_import_export_stock', 'add_can_partner_borrow', 'add_can_view_buying_prices',
        'add_can_view_reports', 'add_can_print_full_receipt', 'add_can_print_delivery_note', 'add_can_manage_customers',
        'add_can_manage_partners', 'add_can_void_orders', 'add_can_edit_company_settings'
      ].forEach(id => check(id, true));
    }
  }
</script>

<%- include('partials/footer') %>
