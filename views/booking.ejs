<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Header Banner -->
<section style="padding: 140px 0 50px; background: linear-gradient(to bottom, rgba(17, 17, 17, 0.8), var(--bg-primary)), url('/src/assets/images/hero_background_1785877478689.jpg') center/cover; text-align: center; border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <span class="section-subtitle">KIGALI STUDIO APPOINTMENT SYSTEM</span>
    <h1 class="section-title gold-gradient-text" style="font-size: 3.2rem;">BOOK A SESSION WITH WESLEY</h1>
    <div class="section-divider"></div>
    <p style="max-width: 650px; margin: 20px auto 0; font-size: 1.05rem; color: var(--text-secondary);">
      Select your desired creative service, pick an available date on our Kigali calendar, choose a time slot, and confirm your booking.
    </p>
  </div>
</section>

<!-- Booking Interface -->
<section class="section">
  <div class="container" style="max-width: 960px;">
    
    <% if (success) { %>
      <div id="bookingSuccessMsg" style="background: rgba(34, 197, 94, 0.15); border: 1px solid var(--status-green); color: #22c55e; padding: 24px; border-radius: 8px; margin-bottom: 30px; text-align: center;">
        <i class="fa-solid fa-circle-check" style="font-size: 2.5rem; margin-bottom: 12px; display: block;"></i>
        <h3 style="font-size: 1.5rem; color: #ffffff;">Booking Request Received!</h3>
        <p style="color: var(--text-primary); margin-top: 8px;">
          Thank you for choosing Wesley Studio. Our team in Kigali will review your request and confirm your reservation within 12 hours.
        </p>
      </div>
    <% } %>

    <div id="bookingSuccessMsg" style="display: none; background: rgba(34, 197, 94, 0.15); border: 1px solid var(--status-green); color: #22c55e; padding: 24px; border-radius: 8px; margin-bottom: 30px; text-align: center;">
      <i class="fa-solid fa-circle-check" style="font-size: 2.5rem; margin-bottom: 12px; display: block;"></i>
      <h3 style="font-size: 1.5rem; color: #ffffff;">Booking Request Submitted Successfully!</h3>
      <p style="color: var(--text-primary); margin-top: 8px;">
        We have logged your appointment. Wesley Studio will contact you via phone/email to finalize session details.
      </p>
    </div>

    <div class="booking-card">
      <div class="booking-steps">
        <div class="step-item active" id="stepIndicator1">
          <div class="step-number">1</div>
          <span class="step-label">Service</span>
        </div>
        <div class="step-item" id="stepIndicator2">
          <div class="step-number">2</div>
          <span class="step-label">Date</span>
        </div>
        <div class="step-item" id="stepIndicator3">
          <div class="step-number">3</div>
          <span class="step-label">Time</span>
        </div>
        <div class="step-item" id="stepIndicator4">
          <div class="step-number">4</div>
          <span class="step-label">Details</span>
        </div>
      </div>

      <form id="bookingForm" action="/booking" method="POST">
        <!-- Hidden Inputs for Form State -->
        <input type="hidden" name="service_id" id="selectedServiceId" value="<%= queryService || (services[0] ? services[0].id : '') %>">
        <input type="hidden" name="date" id="bookingDateInput" value="">
        <input type="hidden" name="time" id="bookingTimeInput" value="">

        <!-- STEP 1: Select Service -->
        <div style="margin-bottom: 40px;">
          <h3 style="margin-bottom: 8px; font-size: 1.3rem;"><i class="fa-solid fa-1 gold-text" style="margin-right: 8px;"></i> Select Service</h3>
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 20px;">Choose the production or photography service you require:</p>

          <div class="services-grid">
            <% services.forEach(service => { %>
              <div class="service-card <%= (queryService == service.id || (!queryService && service.id === services[0]?.id)) ? 'selected' : '' %>" data-id="<%= service.id %>" data-name="<%= service.name %>">
                <h4 class="service-title"><%= service.name %></h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary); min-height: 48px;"><%= service.description %></p>
                <div class="service-meta">
                  <span><i class="fa-solid fa-clock"></i> <%= service.duration %></span>
                  <span><i class="fa-solid fa-tag"></i> <%= service.price %></span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- STEP 2: Choose Date Calendar -->
        <div style="margin-bottom: 40px;">
          <h3 style="margin-bottom: 8px; font-size: 1.3rem;"><i class="fa-solid fa-2 gold-text" style="margin-right: 8px;"></i> Choose Date</h3>
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 16px;">
            Select an available date on Wesley's Kigali calendar:
          </p>

          <!-- Legend -->
          <div style="display: flex; gap: 20px; margin-bottom: 16px; font-size: 0.8rem;">
            <span style="color: #22c55e;"><i class="fa-solid fa-circle"></i> Green = Available</span>
            <span style="color: #ef4444;"><i class="fa-solid fa-circle"></i> Red = Booked / Blocked</span>
            <span style="color: #eab308;"><i class="fa-solid fa-circle"></i> Yellow = Pending Review</span>
          </div>

          <div class="calendar-wrap">
            <div class="calendar-header">
              <span id="calendarMonthTitle" style="font-family: var(--font-heading); font-size: 1.2rem; color: var(--accent-gold);">AUGUST 2026</span>
              <span style="font-size: 0.85rem; color: var(--text-secondary);">Kigali Time (GMT+2)</span>
            </div>

            <div class="calendar-grid">
              <div class="calendar-day-header">MON</div>
              <div class="calendar-day-header">TUE</div>
              <div class="calendar-day-header">WED</div>
              <div class="calendar-day-header">THU</div>
              <div class="calendar-day-header">FRI</div>
              <div class="calendar-day-header">SAT</div>
              <div class="calendar-day-header">SUN</div>

              <% 
                // Generate August 2026 calendar dates (1 to 31)
                const confirmedDates = existingBookings.filter(b => b.status === 'confirmed').map(b => b.date);
                const pendingDates = existingBookings.filter(b => b.status === 'pending').map(b => b.date);
                const blockedDates = blockedAvailability.map(a => a.date);

                for (let day = 1; day <= 31; day++) {
                  const dayStr = day < 10 ? '0' + day : '' + day;
                  const fullDateStr = `2026-08-${dayStr}`;

                  let statusClass = 'available';
                  if (confirmedDates.includes(fullDateStr) || blockedDates.includes(fullDateStr)) {
                    statusClass = 'booked';
                  } else if (pendingDates.includes(fullDateStr)) {
                    statusClass = 'pending';
                  }
              %>
                <div class="calendar-date <%= statusClass %>" data-date="<%= fullDateStr %>">
                  <%= day %>
                </div>
              <% } %>
            </div>
          </div>
          <p style="font-size: 0.9rem; color: var(--accent-gold);">Selected Date: <strong id="selectedDateDisplay" style="color: #fff;">None selected</strong></p>
        </div>

        <!-- STEP 3: Choose Time Slot -->
        <div style="margin-bottom: 40px;">
          <h3 style="margin-bottom: 8px; font-size: 1.3rem;"><i class="fa-solid fa-3 gold-text" style="margin-right: 8px;"></i> Choose Time Slot</h3>
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 16px;">Select your preferred appointment time:</p>

          <div class="time-slots-grid">
            <div class="time-slot available" data-time="09:00">09:00 AM</div>
            <div class="time-slot available" data-time="11:00">11:00 AM</div>
            <div class="time-slot available" data-time="14:00">02:00 PM</div>
            <div class="time-slot available" data-time="16:00">04:00 PM</div>
            <div class="time-slot available" data-time="18:00">06:00 PM</div>
          </div>
          <p style="font-size: 0.9rem; color: var(--accent-gold); margin-top: 12px;">Selected Time: <strong id="selectedTimeDisplay" style="color: #fff;">None selected</strong></p>
        </div>

        <!-- STEP 4 & 5: Contact Info -->
        <div style="margin-bottom: 30px;">
          <h3 style="margin-bottom: 8px; font-size: 1.3rem;"><i class="fa-solid fa-4 gold-text" style="margin-right: 8px;"></i> Client Details</h3>
          <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 20px;">Fill in your contact information to finalize booking:</p>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px;">
            <div class="form-group">
              <label class="form-label">Full Name *</label>
              <input type="text" name="client_name" class="form-input" placeholder="e.g. Jean-Luc Nkurunziza" required>
            </div>
            <div class="form-group">
              <label class="form-label">Email Address *</label>
              <input type="email" name="email" class="form-input" placeholder="e.g. name@domain.com" required>
            </div>
            <div class="form-group">
              <label class="form-label">Phone / WhatsApp *</label>
              <input type="tel" name="phone" class="form-input" placeholder="+250 788 000 000" required>
            </div>
            <div class="form-group">
              <label class="form-label">Shoot Location</label>
              <input type="text" name="location" class="form-input" placeholder="e.g. Kigali Studio / Lake Kivu">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Project Vision / Special Instructions</label>
            <textarea name="message" class="form-textarea" placeholder="Describe your film/photo goals, aesthetic preferences, or deadline..."></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-gold" style="width: 100%; padding: 18px; font-size: 1.1rem;">
          <i class="fa-solid fa-check-circle"></i> Submit Booking Reservation
        </button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
