<%- include('../partials/header', { title: 'VectOS SuperAdmin Administration & Client Billing Engine' }) %>
<%- include('../partials/sidebar') %>

<div class="space-y-6 max-w-7xl mx-auto">
  <!-- Top Banner: VectOS Global Administration -->
  <div class="pb-4 border-b border-[#222732] flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 font-black shadow-lg shadow-amber-500/20">
          <i data-lucide="shield" class="w-5 h-5"></i>
        </div>
        <div>
          <h1 class="text-2xl font-extrabold text-white tracking-tight font-display flex items-center space-x-2">
            <span>VectOS SuperAdmin Portal</span>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-black bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase tracking-wider font-mono">
              Central Master
            </span>
          </h1>
          <p class="text-xs text-slate-400 mt-0.5">
            Client Company Approvals, Account Activation Management & Dynamic Tier Pricing Engine (Base RWF 15k + 5k/user + 5k/stock).
          </p>
        </div>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <a href="/register-shop" target="_blank"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-[#1F242E] hover:bg-[#2B313E] text-slate-200 border border-[#2B313E] font-bold text-xs transition-all">
        <i data-lucide="external-link" class="w-4 h-4 text-amber-400"></i>
        <span>Public Registration Link</span>
      </a>
    </div>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-xs flex items-center space-x-2">
      <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
      <span><%= message %></span>
    </div>
  <% } %>

  <!-- Platform Revenue & Deployment KPIs -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3.5">
    <div class="bg-[#13161C] border border-[#222732] p-4 rounded-2xl">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Registered Companies</span>
      <p class="text-2xl font-black text-white font-mono mt-1"><%= stats.totalShops %></p>
      <span class="text-[10px] text-slate-500">Active & Onboarding</span>
    </div>

    <div class="bg-[#13161C] border border-emerald-500/20 p-4 rounded-2xl">
      <span class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider block">Active Subscribed</span>
      <p class="text-2xl font-black text-emerald-400 font-mono mt-1"><%= stats.activeShops %></p>
      <span class="text-[10px] text-emerald-500/70">Operational Depots</span>
    </div>

    <div class="bg-[#13161C] border border-amber-500/30 p-4 rounded-2xl bg-amber-500/5">
      <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider block">Pending Approvals</span>
      <p class="text-2xl font-black text-amber-400 font-mono mt-1"><%= stats.pendingShops %></p>
      <span class="text-[10px] text-amber-500/80 font-semibold"><%= stats.totalPendingStaff || 0 %> Staff Awaiting Activation</span>
    </div>

    <div class="bg-[#13161C] border border-[#222732] p-4 rounded-2xl">
      <span class="text-[11px] font-bold text-amber-400 uppercase tracking-wider block">Monthly MRR (VectOS)</span>
      <p class="text-xl font-black text-amber-400 font-mono mt-1">RWF <%= (stats.totalMonthlyMRR || 0).toLocaleString('en-US') %></p>
      <span class="text-[10px] text-slate-500">Recurring SaaS Revenue</span>
    </div>

    <div class="bg-[#13161C] border border-[#222732] p-4 rounded-2xl col-span-2 sm:col-span-1">
      <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Client GMV Volume</span>
      <p class="text-lg font-black text-white font-mono mt-1">RWF <%= (stats.platformSales || 0).toLocaleString('en-US') %></p>
      <span class="text-[10px] text-slate-500">Total Sales Processed</span>
    </div>
  </div>

  <!-- SuperAdmin Assistance Notice -->
  <div class="p-4 bg-gradient-to-r from-amber-500/10 via-slate-900 to-[#13161C] border border-amber-500/30 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="flex items-center space-x-3.5">
      <div class="w-10 h-10 rounded-xl bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400 shrink-0">
        <i data-lucide="life-buoy" class="w-5 h-5"></i>
      </div>
      <div>
        <h4 class="text-xs font-bold text-white uppercase tracking-wider">SuperAdmin Live Support & Stock Inspection Mode</h4>
        <p class="text-[11px] text-slate-300">
          When a store owner contacts you for support, click <strong class="text-amber-400">"Inspect Stock"</strong> to switch into their isolated workspace. Click "Exit" in the top bar anytime to return to VectOS master controls.
        </p>
      </div>
    </div>
  </div>

  <!-- Companies Table with Billing Breakdown -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden">
    <div class="p-4 border-b border-[#222732] flex items-center justify-between">
      <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2">
        <i data-lucide="building-2" class="w-4 h-4 text-amber-400"></i>
        <span>Registered Client Companies & Subscription Billing</span>
      </h3>
      <span class="text-[11px] text-slate-400 font-mono"><%= shops.length %> Companies</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[#222732] bg-[#181C24] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4">Company Details</th>
            <th class="py-3.5 px-4">Manager Contact</th>
            <th class="py-3.5 px-4">TIN & Location</th>
            <th class="py-3.5 px-4">Monthly Fee & Billing Breakdown</th>
            <th class="py-3.5 px-4 text-center">Accounts / Stocks</th>
            <th class="py-3.5 px-4 text-center">Status</th>
            <th class="py-3.5 px-4 text-right">SuperAdmin Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1D222B]">
          <% shops.forEach(s => { %>
            <tr class="hover:bg-[#1A1E26] transition-colors <%= s.status === 'pending' ? 'bg-amber-500/5' : '' %>">
              
              <!-- Company Name & Code -->
              <td class="py-4 px-4">
                <div class="font-bold text-white text-sm flex items-center space-x-1.5">
                  <span><%= s.name %></span>
                </div>
                <div class="text-[11px] text-amber-500 font-mono mt-0.5">Code: <%= s.code %></div>
                <div class="text-[10px] text-slate-500">
                  Type: <span class="text-slate-300"><%= s.business_type || 'Hardware' %></span> • Joined <%= new Date(s.created_at).toLocaleDateString() %>
                </div>
              </td>

              <!-- Manager Info -->
              <td class="py-4 px-4">
                <div class="font-semibold text-slate-200"><%= s.owner_name %></div>
                <div class="text-[11px] text-slate-400 font-mono"><%= s.phone %></div>
                <div class="text-[10px] text-slate-500"><%= s.email %></div>
              </td>

              <!-- TIN & Location -->
              <td class="py-4 px-4">
                <div class="font-mono text-slate-300 font-bold">
                  <%= s.tin_number ? 'TIN: ' + s.tin_number : 'No TIN Set' %>
                </div>
                <div class="text-[11px] text-slate-400 flex items-center space-x-1 mt-0.5">
                  <i data-lucide="map-pin" class="w-3 h-3 text-slate-500"></i>
                  <span><%= s.location || 'Kigali, Rwanda' %></span>
                </div>
              </td>

              <!-- Monthly Fee & Pricing Formula Breakdown -->
              <td class="py-4 px-4">
                <div class="font-mono font-bold text-amber-400 text-sm">
                  RWF <%= (s.monthly_fee || 20000).toLocaleString('en-US') %>/mo
                </div>
                <div class="text-[10px] text-slate-400 mt-0.5">
                  Base (15k) + <%= s.billed_accounts || 1 %> user(s) + <%= s.billed_stocks || 1 %> stock(s)
                </div>
                <% if (s.billing_notes) { %>
                  <div class="text-[10px] text-slate-500 italic max-w-xs truncate" title="<%= s.billing_notes %>">
                    Note: <%= s.billing_notes %>
                  </div>
                <% } %>
                <button onclick='openEditBillingModal(<%= JSON.stringify(s) %>)' 
                  class="mt-1 text-[10px] text-amber-400 hover:text-amber-300 underline font-semibold cursor-pointer">
                  Adjust Pricing & Billing Tier
                </button>
              </td>

              <!-- Accounts and Stocks Count -->
              <td class="py-4 px-4 text-center font-mono">
                <div class="font-bold text-white"><%= s.user_count || 0 %> Accounts</div>
                <span class="block text-[10px] text-slate-400"><%= s.stock_count || 1 %> Warehouses</span>
                <% if (s.pending_user_count > 0) { %>
                  <span class="inline-block mt-0.5 px-1.5 py-0.2 rounded text-[9px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 animate-pulse">
                    <%= s.pending_user_count %> Pending Approval
                  </span>
                <% } %>
              </td>

              <!-- Status Badge -->
              <td class="py-4 px-4 text-center">
                <% if (s.status === 'active') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Active
                  </span>
                <% } else if (s.status === 'pending') { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">
                    Pending Approval
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    Suspended (Cascade)
                  </span>
                <% } %>
              </td>

              <!-- SuperAdmin Actions -->
              <td class="py-4 px-4 text-right">
                <div class="flex items-center justify-end space-x-1.5">
                  
                  <!-- Enter & Assist Mode -->
                  <a href="/admin/switch-shop/<%= s.id %>" 
                    class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 font-bold text-[11px] border border-amber-500/30 transition-all flex items-center space-x-1"
                    title="Enter this company's isolated stock to assist them">
                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                    <span>Inspect Stock</span>
                  </a>

                  <!-- Approval Form for Pending -->
                  <% if (s.status === 'pending') { %>
                    <form action="/admin/shops/approve/<%= s.id %>" method="POST" class="inline">
                      <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-[11px] shadow-md transition-all flex items-center space-x-1 cursor-pointer">
                        <i data-lucide="check" class="w-3.5 h-3.5"></i>
                        <span>Approve</span>
                      </button>
                    </form>
                  <% } else if (s.status === 'active') { %>
                    <!-- Suspend Toggle -->
                    <form action="/admin/shops/toggle-status/<%= s.id %>" method="POST" class="inline" onsubmit="return confirm('Suspend subscription for <%= s.name %>? This will cascade suspend all employee accounts in this company.')">
                      <input type="hidden" name="new_status" value="suspended">
                      <button type="submit" class="p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/20 transition-all cursor-pointer" title="Suspend Subscription (Cascade to all staff)">
                        <i data-lucide="pause-circle" class="w-4 h-4"></i>
                      </button>
                    </form>
                  <% } else { %>
                    <!-- Reactivate -->
                    <form action="/admin/shops/toggle-status/<%= s.id %>" method="POST" class="inline">
                      <input type="hidden" name="new_status" value="active">
                      <button type="submit" class="px-2.5 py-1.5 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 font-bold text-[11px] transition-all flex items-center space-x-1 cursor-pointer">
                        <i data-lucide="play-circle" class="w-3.5 h-3.5"></i>
                        <span>Reactivate</span>
                      </button>
                    </form>
                  <% } %>

                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- All Staff Accounts & Instant Activation Management Table -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden">
    <div class="p-4 border-b border-[#222732] flex items-center justify-between">
      <div>
        <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center space-x-2">
          <i data-lucide="users" class="w-4 h-4 text-amber-400"></i>
          <span>Staff Accounts Across Companies & SuperAdmin Activation Controls</span>
        </h3>
        <p class="text-[11px] text-slate-400 mt-0.5">
          Store managers register employees; SuperAdmin activates accounts upon payment negotiation (+RWF 5,000/mo or temporary pass).
        </p>
      </div>
      <span class="text-[11px] text-slate-400 font-mono"><%= allUsers ? allUsers.length : 0 %> Total Accounts</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[#222732] bg-[#181C24] text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3 px-4">User Name / Email</th>
            <th class="py-3 px-4">Assigned Company</th>
            <th class="py-3 px-4">Role & Job Title</th>
            <th class="py-3 px-4">Stock Warehouse</th>
            <th class="py-3 px-4 text-center">Activation Status</th>
            <th class="py-3 px-4 text-right">SuperAdmin Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1D222B]">
          <% if (allUsers && allUsers.length > 0) { %>
            <% allUsers.forEach(u => { %>
              <tr class="hover:bg-[#1A1E26] transition-colors <%= u.activation_status === 'pending_approval' ? 'bg-amber-500/5' : '' %>">
                <td class="py-3.5 px-4">
                  <div class="font-bold text-white"><%= u.name %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= u.email %> • <%= u.phone || 'No phone' %></div>
                </td>

                <td class="py-3.5 px-4 font-semibold text-slate-300">
                  <%= u.shop_name || 'VectOS Platform' %>
                </td>

                <td class="py-3.5 px-4">
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider <%= u.role === 'manager' || u.role === 'superadmin' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-slate-800 text-slate-300' %>">
                    <%= u.job_title || u.role %>
                  </span>
                </td>

                <td class="py-3.5 px-4 text-slate-400 font-mono text-[11px]">
                  <%= u.stock_name || 'Main Stock' %>
                </td>

                <td class="py-3.5 px-4 text-center">
                  <% if (!u.is_active) { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                      Deactivated
                    </span>
                  <% } else if (u.activation_status === 'pending_approval') { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">
                      Pending Activation
                    </span>
                  <% } else if (u.activation_status === 'suspended') { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                      Suspended
                    </span>
                  <% } else { %>
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                      Active
                    </span>
                  <% } %>
                </td>

                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end space-x-2">
                    <% if (!u.is_active || u.activation_status !== 'active') { %>
                      <form action="/admin/users/toggle-activation/<%= u.id %>" method="POST" class="inline">
                        <input type="hidden" name="new_status" value="active">
                        <button type="submit" class="px-3 py-1 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-[11px] shadow transition-all cursor-pointer">
                          Activate Account
                        </button>
                      </form>
                    <% } else { %>
                      <form action="/admin/users/toggle-activation/<%= u.id %>" method="POST" class="inline" onsubmit="return confirm('Deactivate account for <%= u.name %>?')">
                        <input type="hidden" name="new_status" value="suspended">
                        <button type="submit" class="px-2.5 py-1 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/20 font-bold text-[11px] transition-all cursor-pointer">
                          Deactivate
                        </button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Adjust Billing Tier & Pricing Parameters -->
<div id="editBillingModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-[#222732]">
      <h3 class="text-base font-bold text-white flex items-center space-x-2">
        <i data-lucide="calculator" class="w-5 h-5 text-amber-400"></i>
        <span>Adjust Company Subscription Billing</span>
      </h3>
      <button onclick="closeEditBillingModal()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="billingForm" action="" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-slate-300 mb-1">Company Name</label>
        <input type="text" id="billingShopName" disabled class="w-full px-3 py-2 bg-slate-900 border border-[#2D3340] rounded-xl text-slate-400 outline-none">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Billed Accounts Count</label>
          <input type="number" name="billed_accounts" id="billingAccountsInput" min="1" oninput="calculateModalFee()" required
            class="w-full px-3 py-2 bg-[#181C24] border border-[#2D3340] rounded-xl text-white focus:border-amber-400 outline-none font-mono">
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Billed Stock Depots Count</label>
          <input type="number" name="billed_stocks" id="billingStocksInput" min="1" oninput="calculateModalFee()" required
            class="w-full px-3 py-2 bg-[#181C24] border border-[#2D3340] rounded-xl text-white focus:border-amber-400 outline-none font-mono">
        </div>
      </div>

      <div>
        <label class="block font-bold text-slate-300 mb-1">Agreed Total Monthly Fee (RWF) *</label>
        <input type="number" name="monthly_fee" id="billingFeeInput" min="15000" step="500" required
          class="w-full px-3 py-2.5 bg-[#181C24] border border-amber-500/40 rounded-xl text-amber-400 font-mono font-bold text-base outline-none">
        <p class="text-[10px] text-slate-500 mt-1">
          Formula: Base 15,000 + (Accounts × 5,000) + (Stocks × 5,000). You can override with negotiated custom fee.
        </p>
      </div>

      <div>
        <label class="block font-bold text-slate-300 mb-1">Billing Notes / Duration / Agreements</label>
        <textarea name="billing_notes" id="billingNotesInput" rows="2" placeholder="e.g. Temporary 2-week tax declaration pass for 2 extra counter staff."
          class="w-full px-3 py-2 bg-[#181C24] border border-[#2D3340] rounded-xl text-white focus:border-amber-400 outline-none"></textarea>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-3 border-t border-[#222732]">
        <button type="button" onclick="closeEditBillingModal()" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700">Cancel</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold shadow-md">Save Subscription Tier</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditBillingModal(shop) {
    document.getElementById('billingForm').action = '/admin/shops/update-billing/' + shop.id;
    document.getElementById('billingShopName').value = shop.name + ' (' + (shop.code || '') + ')';
    document.getElementById('billingAccountsInput').value = shop.billed_accounts || 1;
    document.getElementById('billingStocksInput').value = shop.billed_stocks || 1;
    document.getElementById('billingFeeInput').value = shop.monthly_fee || (15000 + (shop.billed_accounts || 1)*5000 + (shop.billed_stocks || 1)*5000);
    document.getElementById('billingNotesInput').value = shop.billing_notes || '';
    document.getElementById('editBillingModal').classList.remove('hidden');
  }

  function closeEditBillingModal() {
    document.getElementById('editBillingModal').classList.add('hidden');
  }

  function calculateModalFee() {
    const accounts = Math.max(1, parseInt(document.getElementById('billingAccountsInput').value) || 1);
    const stocks = Math.max(1, parseInt(document.getElementById('billingStocksInput').value) || 1);
    const fee = 15000 + (accounts * 5000) + (stocks * 5000);
    document.getElementById('billingFeeInput').value = fee;
  }
</script>

<%- include('../partials/footer') %>
