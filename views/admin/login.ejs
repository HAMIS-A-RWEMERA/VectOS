<%- include('../partials/header') %>

<section style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px; background: radial-gradient(circle at center, rgba(212, 175, 55, 0.08) 0%, rgba(17, 17, 17, 1) 70%);">
  <div style="background: var(--bg-secondary); border: 1px solid var(--border-gold); padding: 40px; border-radius: 12px; width: 100%; max-width: 440px; box-shadow: var(--shadow-gold);">
    <div style="text-align: center; margin-bottom: 30px;">
      <span class="brand-title" style="font-size: 2.2rem; display: block;">WESLEY</span>
      <span class="brand-subtitle">STUDIO MANAGEMENT PORTAL</span>
    </div>

    <% if (error) { %>
      <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid var(--status-red); color: #ef4444; padding: 12px; border-radius: 6px; margin-bottom: 20px; font-size: 0.85rem; text-align: center;">
        <i class="fa-solid fa-triangle-exclamation"></i> <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label class="form-label">Admin Email</label>
        <input type="email" name="email" class="form-input" value="admin@wesley.rw" placeholder="admin@wesley.rw" required>
      </div>

      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-input" value="wesley2026!" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-gold" style="width: 100%; padding: 14px; margin-top: 10px;">
        <i class="fa-solid fa-lock-open"></i> Login to Studio CMS
      </button>
    </form>

    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border-subtle); text-align: center; font-size: 0.8rem; color: var(--text-muted);">
      <p>Default Credentials:</p>
      <code style="color: var(--accent-gold); display: block; margin-top: 4px;">admin@wesley.rw / wesley2026!</code>
      <a href="/" style="color: var(--text-secondary); text-decoration: none; display: inline-block; margin-top: 12px;">← Return to Public Website</a>
    </div>
  </div>
</section>

</body>
</html>
