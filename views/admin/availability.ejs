<%- include('../partials/header') %>
<%- include('../partials/admin_header') %>

<div class="admin-layout">
  <div class="admin-sidebar">
    <ul class="footer-links" style="display: flex; flex-direction: column; gap: 16px;">
      <li><a href="/admin/dashboard"><i class="fa-solid fa-chart-line" style="margin-right: 8px;"></i> Overview</a></li>
      <li><a href="/admin/photos"><i class="fa-solid fa-camera" style="margin-right: 8px;"></i> Photos</a></li>
      <li><a href="/admin/films"><i class="fa-solid fa-film" style="margin-right: 8px;"></i> Films</a></li>
      <li><a href="/admin/bookings"><i class="fa-solid fa-calendar-check" style="margin-right: 8px;"></i> Bookings</a></li>
      <li><a href="/admin/availability" style="color: var(--accent-gold); font-weight: 600;"><i class="fa-solid fa-clock" style="margin-right: 8px;"></i> Availability</a></li>
      <li><a href="/admin/messages"><i class="fa-solid fa-envelope" style="margin-right: 8px;"></i> Messages</a></li>
    </ul>
  </div>

  <div class="admin-main">
    <h1 style="font-size: 2rem; margin-bottom: 24px;">STUDIO AVAILABILITY & WORKING HOURS</h1>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; margin-bottom: 30px;">
      <!-- Standard Working Hours -->
      <div class="admin-card">
        <h3 style="margin-bottom: 16px;"><i class="fa-solid fa-business-time gold-text"></i> Standard Working Schedule</h3>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 0.95rem;">
          <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
            <span>Monday – Friday</span>
            <strong style="color: #22c55e;">09:00 AM – 05:00 PM</strong>
          </li>
          <li style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px;">
            <span>Saturday</span>
            <strong style="color: #22c55e;">10:00 AM – 04:00 PM</strong>
          </li>
          <li style="display: flex; justify-content: space-between;">
            <span>Sunday</span>
            <strong style="color: #ef4444;">Unavailable (Rest / Location Shoots)</strong>
          </li>
        </ul>
      </div>

      <!-- Block Custom Date / Time Slot Form -->
      <div class="admin-card">
        <h3 style="margin-bottom: 16px;"><i class="fa-solid fa-ban gold-text"></i> Block Date / Time Slot</h3>
        <form action="/admin/availability/block" method="POST">
          <div class="form-group">
            <label class="form-label">Date to Block *</label>
            <input type="date" name="date" class="form-input" required>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div class="form-group">
              <label class="form-label">Start Time *</label>
              <input type="text" name="start_time" class="form-input" placeholder="09:00" required>
            </div>
            <div class="form-group">
              <label class="form-label">End Time</label>
              <input type="text" name="end_time" class="form-input" placeholder="17:00">
            </div>
          </div>

          <button type="submit" class="btn btn-gold" style="width: 100%;">
            <i class="fa-solid fa-lock"></i> Block Date / Time
          </button>
        </form>
      </div>
    </div>

    <!-- Blocked Slots List -->
    <div class="admin-card">
      <h3 style="margin-bottom: 20px;"><i class="fa-solid fa-calendar-xmark gold-text"></i> Blocked Schedule Overrides (<%= blockedSlots.length %>)</h3>

      <% if (blockedSlots.length === 0) { %>
        <p style="color: var(--text-muted);">No custom date blocks set.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Time Window</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% blockedSlots.forEach(slot => { %>
                <tr>
                  <td><strong style="color: var(--accent-gold);"><%= slot.date %></strong></td>
                  <td><%= slot.start_time %> to <%= slot.end_time %></td>
                  <td><span class="status-badge status-cancelled">BLOCKED</span></td>
                  <td>
                    <form action="/admin/availability/delete/<%= slot.id %>" method="POST">
                      <button type="submit" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.75rem; color: #22c55e; border-color: rgba(34, 197, 94, 0.4);">
                        <i class="fa-solid fa-unlock"></i> Unblock
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

</body>
</html>
