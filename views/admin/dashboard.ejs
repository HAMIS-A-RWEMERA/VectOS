<%- include('../partials/header') %>
<%- include('../partials/admin_header') %>

<div class="admin-layout">
  <!-- Sidebar -->
  <div class="admin-sidebar">
    <div style="margin-bottom: 30px;">
      <span style="font-size: 0.75rem; color: var(--accent-gold); letter-spacing: 0.1em; text-transform: uppercase;">NAVIGATE</span>
    </div>
    <ul class="footer-links" style="display: flex; flex-direction: column; gap: 16px;">
      <li><a href="/admin/dashboard" style="color: var(--accent-gold); font-weight: 600;"><i class="fa-solid fa-chart-line" style="margin-right: 8px;"></i> Overview</a></li>
      <li><a href="/admin/photos"><i class="fa-solid fa-camera" style="margin-right: 8px;"></i> Photos (<%= stats.photos %>)</a></li>
      <li><a href="/admin/films"><i class="fa-solid fa-film" style="margin-right: 8px;"></i> Films (<%= stats.films %>)</a></li>
      <li><a href="/admin/bookings"><i class="fa-solid fa-calendar-check" style="margin-right: 8px;"></i> Bookings <% if (stats.pendingBookings > 0) { %><span class="status-badge status-pending" style="margin-left: 6px;"><%= stats.pendingBookings %></span><% } %></a></li>
      <li><a href="/admin/availability"><i class="fa-solid fa-clock" style="margin-right: 8px;"></i> Availability</a></li>
      <li><a href="/admin/messages"><i class="fa-solid fa-envelope" style="margin-right: 8px;"></i> Messages <% if (stats.unreadMessages > 0) { %><span class="status-badge status-pending" style="margin-left: 6px;"><%= stats.unreadMessages %></span><% } %></a></li>
    </ul>
  </div>

  <!-- Main Content -->
  <div class="admin-main">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
      <div>
        <h1 style="font-size: 2rem;">STUDIO DASHBOARD</h1>
        <p style="color: var(--text-secondary);">Welcome back, <%= user.name %>. Overview of Wesley Studio performance.</p>
      </div>
      <a href="/admin/photos" class="btn btn-gold"><i class="fa-solid fa-upload"></i> Upload New Media</a>
    </div>

    <!-- Stat Grid -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-camera"></i></div>
        <div>
          <div class="stat-val"><%= stats.photos %></div>
          <div class="stat-lbl">Total Photos</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon"><i class="fa-solid fa-film"></i></div>
        <div>
          <div class="stat-val"><%= stats.films %></div>
          <div class="stat-lbl">Films & Trailers</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="color: #eab308; background: rgba(234, 179, 8, 0.1);"><i class="fa-solid fa-hourglass-half"></i></div>
        <div>
          <div class="stat-val" style="color: #eab308;"><%= stats.pendingBookings %></div>
          <div class="stat-lbl">Pending Bookings</div>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="color: #22c55e; background: rgba(34, 197, 94, 0.1);"><i class="fa-solid fa-calendar-check"></i></div>
        <div>
          <div class="stat-val" style="color: #22c55e;"><%= stats.upcomingBookings %></div>
          <div class="stat-lbl">Confirmed Sessions</div>
        </div>
      </div>
    </div>

    <!-- Recent Bookings Table -->
    <div class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3><i class="fa-solid fa-calendar-days gold-text"></i> Recent Booking Requests</h3>
        <a href="/admin/bookings" class="btn btn-outline" style="font-size: 0.8rem; padding: 6px 14px;">View All</a>
      </div>

      <% if (recentBookings.length === 0) { %>
        <p style="color: var(--text-muted);">No booking requests found.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Client</th>
                <th>Service</th>
                <th>Date & Time</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% recentBookings.forEach(b => { %>
                <tr>
                  <td>
                    <strong><%= b.client_name %></strong><br>
                    <span style="font-size: 0.8rem; color: var(--text-muted);"><%= b.email %></span>
                  </td>
                  <td><%= b.service_name %></td>
                  <td><%= b.date %> at <%= b.time %></td>
                  <td><%= b.phone %></td>
                  <td>
                    <span class="status-badge status-<%= b.status %>"><%= b.status %></span>
                  </td>
                  <td>
                    <a href="/admin/bookings" class="btn btn-outline" style="padding: 4px 10px; font-size: 0.75rem;">Manage</a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Recent Messages -->
    <div class="admin-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h3><i class="fa-solid fa-inbox gold-text"></i> Recent Client Inquiries</h3>
        <a href="/admin/messages" class="btn btn-outline" style="font-size: 0.8rem; padding: 6px 14px;">Inbox</a>
      </div>

      <% if (recentMessages.length === 0) { %>
        <p style="color: var(--text-muted);">No messages in inbox.</p>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 12px;">
          <% recentMessages.forEach(msg => { %>
            <div style="background: var(--bg-card); padding: 16px; border-radius: 6px; border: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong style="color: var(--text-primary);"><%= msg.name %></strong>
                <span style="font-size: 0.8rem; color: var(--accent-gold); margin-left: 10px;"><%= msg.subject %></span>
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 4px;"><%= msg.message.substring(0, 100) %>...</p>
              </div>
              <a href="/admin/messages" class="btn btn-gold-outline" style="padding: 6px 12px; font-size: 0.75rem;">View</a>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

  </div>
</div>

</body>
</html>
