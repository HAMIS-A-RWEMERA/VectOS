<% if (typeof user !== 'undefined' && user) { %>
  </main>
</div>
<% } %>

<% if (typeof dbPersistent !== 'undefined' && !dbPersistent) { %>
<div class="fixed bottom-0 left-0 right-0 z-[60] bg-rose-950/95 border-t border-rose-500/50 text-rose-200 text-[11px] font-semibold px-4 py-1.5 flex items-center justify-center gap-2">
  <i data-lucide="database-zap" class="w-3.5 h-3.5 shrink-0"></i>
  <span>WARNING: Temporary storage mode — all data resets on server restart. Set DATABASE_URL (Supabase) in Netlify environment variables, then clear-cache redeploy.</span>
</div>
<% } %>

<!-- PWA Installation Banner & Offline Notification Toast -->
<div id="pwaInstallBanner" class="hidden fixed bottom-4 right-4 z-50 max-w-sm bg-[var(--c-panel)] border border-amber-500/40 rounded-2xl p-4 shadow-2xl backdrop-blur-xl transition-all">
  <div class="flex items-start space-x-3">
    <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0">
      <i data-lucide="smartphone" class="w-5 h-5 text-amber-400"></i>
    </div>
    <div class="flex-1">
      <h4 class="text-xs font-bold text-white uppercase tracking-wider">Install VectOS App</h4>
      <p class="text-[11px] text-slate-300 mt-0.5">Install on your Android or iPhone for quick home screen access & thermal receipt printing.</p>
      <div class="mt-3 flex items-center space-x-2">
        <button id="pwaInstallBtn" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs shadow-md transition-all">
          Install App
        </button>
        <button onclick="document.getElementById('pwaInstallBanner').classList.add('hidden')" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 text-xs transition-all">
          Dismiss
        </button>
      </div>
    </div>
  </div>
</div>

<div id="offlineToast" class="hidden fixed top-4 right-4 z-50 bg-rose-950/90 border border-rose-500/40 text-rose-200 px-4 py-2.5 rounded-xl shadow-2xl flex items-center space-x-2 text-xs font-semibold">
  <i data-lucide="wifi-off" class="w-4 h-4 text-rose-400"></i>
  <span>Working Offline — Viewing cached store records</span>
</div>

<!-- Lucide Icon Initialization & Global Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof lucide !== 'undefined') {
      lucide.createIcons();
    }

    // Offline mode: register the safe service worker (network-first pages,
    // so online users always see fresh HTML/CSS). Version query busts stale
    // caches after deploy — old workers are replaced on activation.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('/sw.js?v=4').catch(function (err) {
          console.log('[SW] registration failed:', err);
        });
      });
    }

    // Handle PWA Installation
    let deferredPrompt;
    const installBanner = document.getElementById('pwaInstallBanner');
    const installBtn = document.getElementById('pwaInstallBtn');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (installBanner) installBanner.classList.remove('hidden');
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (deferredPrompt) {
          deferredPrompt.prompt();
          const { outcome } = await deferredPrompt.userChoice;
          console.log(`PWA install prompt outcome: ${outcome}`);
          deferredPrompt = null;
          installBanner.classList.add('hidden');
        }
      });
    }

    // Detect Offline / Online
    const offlineToast = document.getElementById('offlineToast');
    function updateOnlineStatus() {
      if (!navigator.onLine) {
        if (offlineToast) offlineToast.classList.remove('hidden');
      } else {
        if (offlineToast) offlineToast.classList.add('hidden');
      }
    }
    window.addEventListener('online', updateOnlineStatus);
    window.addEventListener('offline', updateOnlineStatus);
    updateOnlineStatus();
  });
</script>

<!-- ================================================================
     VECTOS OFFLINE ENGINE — the business keeps working without
     internet. While offline, any business form (stock adjustments,
     customer registration, product adds, etc.) is saved on this
     device and replayed automatically when connectivity returns.
     The POS order screen has its own dedicated queue and is skipped.
================================================================= -->
<script>
(function () {
  var QUEUE_KEY = 'vectos_form_queue';

  function getQueue() {
    try { return JSON.parse(localStorage.getItem(QUEUE_KEY) || '[]'); } catch (e) { return []; }
  }
  function setQueue(q) {
    try { localStorage.setItem(QUEUE_KEY, JSON.stringify(q)); } catch (e) {}
  }
  function csrfToken() {
    var m = document.querySelector('meta[name="csrf-token"]');
    return m ? m.getAttribute('content') : '';
  }

  function toast(msg) {
    var t = document.getElementById('offlineToast');
    if (!t) return;
    t.querySelector('span').textContent = msg;
    t.classList.remove('hidden');
    setTimeout(function () { t.classList.add('hidden'); }, 6000);
  }

  // Capture form submissions made while OFFLINE
  document.addEventListener('submit', function (e) {
    if (navigator.onLine) return;
    var form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    if (form.hasAttribute('data-no-offline')) return;
    if (form.closest('#orderForm')) return;               // POS has its own queue
    if ((form.getAttribute('action') || '').indexOf('/login') !== -1) return;

    e.preventDefault();
    e.stopPropagation();

    var payload = {};
    new FormData(form).forEach(function (v, k) {
      if (k === '_csrf') return;
      payload[k] = v;
    });

    var entry = {
      url: form.getAttribute('action') || window.location.pathname,
      payload: payload,
      ref: Date.now() + '-' + Math.random().toString(36).slice(2, 6),
      at: new Date().toISOString()
    };
    var q = getQueue();
    q.push(entry);
    setQueue(q);
    toast('OFFLINE: saved on this device (' + q.length + ' pending). Will sync automatically.');
  }, true);

  // Replay captured submissions when back online
  function syncQueue() {
    if (!navigator.onLine) return;
    var queue = getQueue();
    if (!queue.length) return;
    var remaining = [];
    var delivered = 0;

    var chain = Promise.resolve();
    queue.forEach(function (entry) {
      chain = chain.then(function () {
        var body = new URLSearchParams(entry.payload);
        body.set('_csrf', csrfToken());
        return fetch(entry.url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body
        }).then(function (res) {
          var bouncedToLogin = res.redirected && /\/login/.test(res.url || '');
          if (res.ok && !bouncedToLogin) {
            delivered++;
          } else if (res.status === 404 || res.status === 400) {
            console.warn('[Offline] dropping invalid entry for', entry.url);
          } else {
            remaining.push(entry); // auth expired or server hiccup — retry later
          }
        }).catch(function () {
          remaining.push(entry);
        });
      });
    });

    chain.then(function () {
      setQueue(remaining);
      if (delivered > 0) toast(delivered + ' offline entr' + (delivered > 1 ? 'ies' : 'y') + ' synced successfully!');
    });
  }

   window.addEventListener('online', syncQueue);
  setInterval(syncQueue, 60000);
  syncQueue();
})();

// Global loading states — disable submit buttons to prevent double-click
document.addEventListener('submit', function(e){
  var form = e.target;
  if(!(form instanceof HTMLFormElement)) return;
  var btn = form.querySelector('button[type="submit"], input[type="submit"]');
  if(btn && !btn.dataset.noDisable){
    btn.dataset.origText = btn.textContent;
    btn.disabled = true;
    btn.style.opacity = '0.6';
    btn.style.cursor = 'not-allowed';
    if(btn.tagName==='BUTTON') btn.textContent = 'Processing...';
    setTimeout(function(){ btn.disabled=false; btn.style.opacity=''; btn.style.cursor=''; if(btn.dataset.origText) btn.textContent=btn.dataset.origText; }, 8000);
  }
});
</script>
</body>
</html>

