<% if (typeof user !== 'undefined' && user) { %>
<!-- Top Navbar / Header Bar -->
<header class="no-print bg-[var(--c-panel)] border-b border-[var(--c-border)] sticky top-0 z-40 px-4 py-2.5 flex flex-col sm:flex-row sm:items-center justify-between shadow-xl gap-2">
  <div class="flex items-center space-x-3">
    <!-- Mobile hamburger -->
    <button type="button" onclick="toggleMobileNav()" class="md:hidden p-2 -ml-2 text-slate-400 hover:text-white hover:bg-[var(--c-chip)] rounded-lg transition-colors" aria-label="Open navigation">
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>
    <a href="/dashboard" class="flex items-center space-x-2.5 group">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 font-black shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform shrink-0">
        <i data-lucide="building-2" class="w-5 h-5"></i>
      </div>
      <div>
        <div class="flex items-center space-x-2">
          <span class="font-black text-sm sm:text-base tracking-wide text-white group-hover:text-amber-400 transition-colors uppercase">
            <%= typeof shop !== 'undefined' && shop ? shop.name : 'VECTOS' %>
          </span>
          <% if (typeof shop !== 'undefined' && shop && shop.tin_number) { %>
            <span class="hidden md:inline-block px-1.5 py-0.2 rounded bg-amber-500/10 border border-amber-500/20 text-[9px] font-mono font-bold text-amber-400">
              TIN: <%= shop.tin_number %>
            </span>
          <% } %>
        </div>
        <span class="text-[10px] font-semibold text-slate-400 flex items-center space-x-1 block -mt-0.5">
          <span><%= typeof shop !== 'undefined' && shop && shop.location ? shop.location : 'Kigali, Rwanda' %></span>
          <% if (typeof shop !== 'undefined' && shop && shop.phone) { %>
            <span>• <%= shop.phone %></span>
          <% } %>
        </span>
      </div>
    </a>
  </div>

  <!-- SuperAdmin Support Mode Alert Bar (if assisting a specific client store) -->
  <% if (typeof isSuperAdminAssisting !== 'undefined' && isSuperAdminAssisting && user.role === 'superadmin') { %>
    <div class="bg-amber-500/20 border border-amber-500/40 px-3 py-1 rounded-xl flex items-center space-x-2 text-xs text-amber-300">
      <i data-lucide="life-buoy" class="w-4 h-4 text-amber-400 shrink-0"></i>
      <span>Assisting Depot: <strong><%= typeof shop !== 'undefined' && shop ? shop.name : 'Store' %></strong></span>
      <a href="/admin/exit-assist" class="ml-1 px-2 py-0.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded text-[10px] transition-colors">
        Exit to Central Platform &rarr;
      </a>
    </div>
  <% } %>

  <!-- Active User Profile, Settings & Sign Out -->
  <div class="flex items-center space-x-3 justify-end">
    <% if (user.role === 'superadmin') { %>
      <a href="/admin/shops" class="px-2.5 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold transition-all flex items-center space-x-1">
        <i data-lucide="shield" class="w-3.5 h-3.5"></i>
        <span>SuperAdmin Portal</span>
      </a>
    <% } %>

    <div class="flex items-center space-x-2.5">
      <div class="text-right hidden sm:block">
        <p class="text-xs font-bold text-white"><%= user.name %></p>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-amber-400">
          <%= user.job_title || user.role %>
        </p>
      </div>

      <a href="/settings" title="Company Profile & Change Password" class="p-2 text-slate-400 hover:text-white hover:bg-[var(--c-chip)] rounded-lg transition-colors border border-transparent hover:border-[var(--c-border2)]">
        <i data-lucide="settings" class="w-4 h-4"></i>
      </a>

      <button type="button" onclick="toggleTheme()" title="Toggle light / dark mode"
        class="p-2 text-slate-400 hover:text-amber-400 hover:bg-[var(--c-chip)] rounded-lg transition-colors cursor-pointer">
        <i data-lucide="sun" data-theme-icon="dark" class="w-4 h-4"></i>
        <i data-lucide="moon" data-theme-icon="light" class="w-4 h-4"></i>
      </button>

      <% if (user.role === 'superadmin') { %>
        <a href="/security/2fa" title="Two-Factor Security" class="p-2 text-slate-400 hover:text-emerald-400 hover:bg-[var(--c-chip)] rounded-lg transition-colors relative">
          <i data-lucide="shield-check" class="w-4 h-4"></i>
        </a>
      <% } %>

      <a href="/logout" title="Sign Out" class="p-2 text-slate-400 hover:text-rose-400 hover:bg-[var(--c-chip)] rounded-lg transition-colors">
        <i data-lucide="log-out" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Drawer (hidden on md+) -->
<div id="mobileNavDrawer" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="toggleMobileNav()"></div>
  <aside class="relative w-72 max-w-[85vw] h-full bg-[var(--c-panel)] border-r border-[var(--c-border)] flex flex-col overflow-y-auto shadow-2xl">
    <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--c-border)]">
      <span class="font-black text-sm text-white uppercase tracking-wide"><%= typeof shop !== 'undefined' && shop ? shop.name : 'VECTOS' %></span>
      <button type="button" onclick="toggleMobileNav()" class="p-2 text-slate-400 hover:text-white rounded-lg" aria-label="Close navigation"><i data-lucide="x" class="w-5 h-5"></i></button>
    </div>
    <div class="p-4 space-y-5">
      <% if (user.role === 'superadmin') { %>
        <div>
          <p class="px-3 text-[10px] font-bold text-amber-400 uppercase tracking-widest mb-1.5">Platform Owner</p>
          <nav class="space-y-1"><a href="/admin/shops" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-bold bg-amber-500/10 text-amber-300 border border-amber-500/20"><i data-lucide="building" class="w-4 h-4"></i><span>All Rwanda Depots</span></a></nav>
        </div>
      <% } %>
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Core Modules</p>
        <nav class="space-y-1 text-xs">
          <a href="/dashboard" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="layout-dashboard" class="w-4 h-4 text-amber-500"></i><span>Dashboard</span></a>
          <a href="/orders" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="shopping-cart" class="w-4 h-4 text-emerald-400"></i><span>Orders & Sales</span></a>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_create_orders) { %><a href="/orders/new" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20"><i data-lucide="plus-circle" class="w-4 h-4"></i><span>New Order</span></a><% } %>
          <a href="/products" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="package" class="w-4 h-4 text-blue-400"></i><span>Inventory Stock</span></a>
          <a href="/stocks" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="warehouse" class="w-4 h-4 text-amber-400"></i><span>Multi-Stock Depots</span></a>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_customers) { %><a href="/customers" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="users" class="w-4 h-4 text-purple-400"></i><span>Customers & Debt</span></a><% } %>
        </nav>
      </div>
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Operational Queues</p>
        <nav class="space-y-1 text-xs">
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_release_stock) { %><a href="/storekeeper" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="warehouse" class="w-4 h-4 text-orange-400"></i><span>Storekeeper Dispatch</span></a><% } %>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_partner_borrow) { %><a href="/accountant/rejected-items" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="refresh-cw" class="w-4 h-4 text-rose-400"></i><span>Resolve Rejected Items</span></a><% } %>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_process_payments) { %><a href="/payments" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="credit-card" class="w-4 h-4 text-teal-400"></i><span>Payments & Cashier</span></a><% } %>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_partners) { %><a href="/partners" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="store" class="w-4 h-4 text-indigo-400"></i><span>Partner Shops</span></a><% } %>
        </nav>
      </div>
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Management & Control</p>
        <nav class="space-y-1 text-xs">
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_view_reports) { %><a href="/reports" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="bar-chart-3" class="w-4 h-4 text-amber-400"></i><span>Profit & Reports</span></a><% } %>
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_users) { %><a href="/users" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="shield-check" class="w-4 h-4 text-cyan-400"></i><span>Staff Roles</span></a><% } %>
          <a href="/settings" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="settings" class="w-4 h-4"></i><span>Settings</span></a>
          <% if (user.role === 'manager' || user.role === 'superadmin') { %><a href="/audit-logs" onclick="toggleMobileNav()" class="flex items-center space-x-3 px-3 py-2 rounded-lg hover:bg-[var(--c-chip)] text-slate-300"><i data-lucide="file-text" class="w-4 h-4 text-slate-500"></i><span>Audit Trail</span></a><% } %>
        </nav>
      </div>
    </div>
  </aside>
</div>
<script>function toggleMobileNav(){var d=document.getElementById('mobileNavDrawer');if(!d)return;d.classList.toggle('hidden');if(!d.classList.contains('hidden')&&typeof lucide!=='undefined')lucide.createIcons();document.body.style.overflow=d.classList.contains('hidden')?'':'hidden';}</script>

<!-- App Main Layout Container -->
<div class="flex flex-1 min-h-0 overflow-hidden">
  <!-- Sidebar Navigation -->
  <aside class="no-print w-64 bg-[var(--c-panel)] border-r border-[var(--c-border)] flex flex-col justify-between hidden md:flex shrink-0">
    <div class="p-4 space-y-5 overflow-y-auto">
      
      <!-- SuperAdmin Platform Section -->
      <% if (user.role === 'superadmin') { %>
        <div>
          <p class="px-3 text-[10px] font-bold text-amber-400 uppercase tracking-widest mb-1.5 flex items-center space-x-1">
            <i data-lucide="crown" class="w-3 h-3 text-amber-400"></i>
            <span>Platform Owner</span>
          </p>
          <nav class="space-y-1">
            <a href="/admin/shops" class="flex items-center space-x-3 px-3 py-2 rounded-lg text-xs font-bold transition-all bg-amber-500/10 hover:bg-amber-500/20 text-amber-300 border border-amber-500/20">
              <i data-lucide="building" class="w-4 h-4 text-amber-400"></i>
              <span>All Rwanda Depots</span>
            </a>
          </nav>
        </div>
      <% } %>

      <!-- Primary Navigation -->
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Core Modules</p>
        <nav class="space-y-1 text-xs">
          <a href="/dashboard" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
            <i data-lucide="layout-dashboard" class="w-4 h-4 text-amber-500"></i>
            <span>Dashboard</span>
          </a>

          <a href="/orders" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
            <i data-lucide="shopping-cart" class="w-4 h-4 text-emerald-400"></i>
            <span>Orders & Sales</span>
          </a>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_create_orders) { %>
            <a href="/orders/new" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-bold transition-all bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/20">
              <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i>
              <span>New Order (Negotiate)</span>
            </a>
          <% } %>

          <a href="/products" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
            <i data-lucide="package" class="w-4 h-4 text-blue-400"></i>
            <span>Inventory Stock</span>
          </a>

          <a href="/stocks" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
            <i data-lucide="warehouse" class="w-4 h-4 text-amber-400"></i>
            <span>Multi-Stock Depots</span>
          </a>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_customers) { %>
            <a href="/customers" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="users" class="w-4 h-4 text-purple-400"></i>
              <span>Customers & Debt</span>
            </a>
          <% } %>
        </nav>
      </div>

      <!-- Role-Specific Action Queues -->
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Operational Queues</p>
        <nav class="space-y-1 text-xs">
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_release_stock) { %>
            <a href="/storekeeper" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="warehouse" class="w-4 h-4 text-orange-400"></i>
              <span>Storekeeper Dispatch</span>
            </a>
          <% } %>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_partner_borrow) { %>
            <a href="/accountant/rejected-items" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="refresh-cw" class="w-4 h-4 text-rose-400"></i>
              <span>Resolve Rejected Items</span>
            </a>
          <% } %>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_process_payments) { %>
            <a href="/payments" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="credit-card" class="w-4 h-4 text-teal-400"></i>
              <span>Payments & Cashier</span>
            </a>
          <% } %>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_partners) { %>
            <a href="/partners" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="store" class="w-4 h-4 text-indigo-400"></i>
              <span>Partner Shops (Sourcing)</span>
            </a>
          <% } %>
        </nav>
      </div>

      <!-- Administration & Intelligence -->
      <div>
        <p class="px-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5">Management & Control</p>
        <nav class="space-y-1 text-xs">
          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_view_reports) { %>
            <a href="/reports" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="bar-chart-3" class="w-4 h-4 text-amber-400"></i>
              <span>Profit & Reports</span>
            </a>
          <% } %>

          <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_users) { %>
            <a href="/users" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="shield-check" class="w-4 h-4 text-cyan-400"></i>
              <span>Staff Roles & Permissions</span>
            </a>
          <% } %>

          <a href="/settings" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
            <i data-lucide="settings" class="w-4 h-4 text-slate-400"></i>
            <span>Company Settings & Password</span>
          </a>

          <% if (user.role === 'manager' || user.role === 'superadmin') { %>
            <a href="/audit-logs" class="flex items-center space-x-3 px-3 py-2 rounded-lg font-medium transition-all hover:bg-[var(--c-chip)] hover:text-white text-slate-300">
              <i data-lucide="file-text" class="w-4 h-4 text-slate-500"></i>
              <span>Audit Trail</span>
            </a>
          <% } %>
        </nav>
      </div>

    </div>

    <!-- Sidebar Footer Badge -->
    <div class="p-3.5 border-t border-[var(--c-border)] bg-[var(--c-app)]">
      <div class="flex items-center justify-between text-[10px] text-slate-500">
        <span class="truncate max-w-[130px] font-semibold"><%= typeof shop !== 'undefined' && shop ? shop.name : 'Vectos ERP' %></span>
        <span class="font-mono text-amber-500/80">v2.1</span>
      </div>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <main class="flex-1 overflow-y-auto bg-[var(--c-app)] p-4 md:p-8">
<% } %>
