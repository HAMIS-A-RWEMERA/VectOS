<%- include('partials/header', { title: 'Two-Factor Security — VectOS' }) %>

<div class="max-w-2xl mx-auto space-y-6 py-6 px-4">
  <% if (typeof msg !== 'undefined' && msg) { %>
    <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-semibold">
      <%= msg %>
    </div>
  <% } %>

  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-6 shadow-xl">
    <div class="flex items-center justify-between pb-4 border-b border-[var(--c-border)]">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center">
          <i data-lucide="shield-check" class="w-5 h-5 text-emerald-400"></i>
        </div>
        <div>
          <h2 class="text-base font-bold text-white">Two-Factor Authentication</h2>
          <p class="text-xs text-slate-400">Protect the master account with a rotating 6-digit code</p>
        </div>
      </div>
      <% if (enabled) { %>
        <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">Active</span>
      <% } else { %>
        <span class="px-3 py-1 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-slate-500/10 text-slate-400 border border-slate-500/30">Off</span>
      <% } %>
    </div>

    <% if (!enabled && qrDataUrl) { %>
      <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-6 items-start">
        <div class="space-y-3 text-xs text-slate-400 leading-relaxed">
          <p class="font-bold text-white text-sm">Step 1 — Scan</p>
          <p>Open Google Authenticator, Authy, Microsoft Authenticator (or any TOTP app) on your phone and scan this QR code.</p>
          <p class="font-bold text-white text-sm pt-2">Step 2 — Verify</p>
          <p>Enter the 6-digit code the app shows for VectOS below. Codes rotate every 30 seconds.</p>
          <div class="pt-2">
            <p class="font-semibold text-slate-300 uppercase tracking-wider text-[10px] mb-1">Manual key (if you cannot scan)</p>
            <code class="block p-2 rounded-lg bg-[var(--c-input)] border border-[var(--c-border)] font-mono text-[11px] text-amber-400 break-all"><%= secret %></code>
          </div>
        </div>

        <div class="flex flex-col items-center space-y-4">
          <img src="<%= qrDataUrl %>" alt="Scan to enroll" class="rounded-xl border border-[var(--c-border2)] w-52 h-52 bg-white p-2">
          <form action="/security/2fa/enable" method="POST" class="w-full space-y-3">
            <input type="text" name="code" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" required
              class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-4 py-3 text-center font-mono text-lg font-bold text-white tracking-[0.4em] focus:outline-none focus:border-amber-500">
            <button type="submit"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-400 to-emerald-600 text-slate-950 font-extrabold text-sm shadow-lg shadow-emerald-500/20 cursor-pointer">
              Activate Two-Factor
            </button>
          </form>
        </div>
      </div>
    <% } else if (enabled) { %>
      <div class="mt-6 space-y-4">
        <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-300 flex items-start space-x-2.5">
          <i data-lucide="lock" class="w-4 h-4 mt-0.5 shrink-0"></i>
          <span>Every sign-in now requires your authenticator code after the password. Keep your phone safe — losing it requires contacting VectOS support to reset access.</span>
        </div>
        <form action="/security/2fa/disable" method="POST" onsubmit="return confirm('Disable two-factor authentication?')"
          class="flex flex-col sm:flex-row items-stretch sm:items-end gap-3 pt-2 border-t border-[var(--c-border)]">
          <div class="flex-1">
            <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Confirm your password to disable</label>
            <input type="password" name="password" required placeholder="Current password"
              class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-rose-500">
          </div>
          <button type="submit"
            class="px-6 py-3 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/30 text-rose-400 font-bold text-sm cursor-pointer transition-all">
            Disable 2FA
          </button>
        </form>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
