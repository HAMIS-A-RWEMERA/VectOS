<%- include('partials/header', { title: 'Password Recovery — VectOS' }) %>

<div class="min-h-screen bg-[#0A0C0F] flex flex-col justify-center py-10 px-4 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-lg text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 text-slate-950 shadow-xl shadow-amber-500/20 mb-3">
      <i data-lucide="key-round" class="w-8 h-8"></i>
    </div>
    <h2 class="text-3xl font-extrabold text-white tracking-tight font-display">Password Recovery</h2>
    <p class="mt-1 text-xs text-amber-400 font-semibold tracking-wider uppercase">VectOS Account Access Restoration</p>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-lg">
    <div class="bg-[#13161C] py-8 px-6 shadow-2xl rounded-2xl border border-[#222732] sm:px-10 space-y-5">

      <div class="p-4 rounded-xl bg-[#171B22] border border-[#2B313E] space-y-3">
        <div class="flex items-start space-x-3">
          <i data-lucide="store" class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5"></i>
          <div>
            <p class="text-xs font-bold text-white uppercase tracking-wider">Staff / Employee Account?</p>
            <p class="text-xs text-slate-400 leading-relaxed mt-1">Ask your <strong class="text-slate-200">Store Manager</strong> to reset it — Managers can change any staff password from the <a href="/login" class="text-amber-400 hover:underline">Staff Management</a> page in their dashboard.</p>
          </div>
        </div>

        <div class="flex items-start space-x-3">
          <i data-lucide="shield-check" class="w-4 h-4 text-amber-400 shrink-0 mt-0.5"></i>
          <div>
            <p class="text-xs font-bold text-white uppercase tracking-wider">Manager / Company Owner?</p>
            <p class="text-xs text-slate-400 leading-relaxed mt-1">Contact the <strong class="text-slate-200">VectOS Platform Super Administrator</strong> (admin@vectos.co.rw). They will verify your identity and issue a temporary password, which you must change after signing in.</p>
          </div>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-start space-x-2.5">
        <i data-lucide="info" class="w-4 h-4 shrink-0 mt-0.5"></i>
        <span class="leading-relaxed">For security, VectOS does not display or email stored passwords. A reset always issues a brand-new temporary credential.</span>
      </div>

      <a href="/login" class="w-full flex justify-center items-center py-3 px-4 border border-transparent rounded-xl shadow-lg text-sm font-bold text-slate-950 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 hover:from-amber-300 hover:to-amber-500 focus:outline-none transition-all cursor-pointer">
        Back to Sign In
      </a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
