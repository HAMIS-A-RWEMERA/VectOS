<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Header Banner -->
<section style="padding: 140px 0 60px; background: linear-gradient(to bottom, rgba(17, 17, 17, 0.8), var(--bg-primary)), url('/src/assets/images/portrait_story_1785877547350.jpg') center/cover; text-align: center; border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <span class="section-subtitle">HUMAN FACES & CULTURAL DIGNITY</span>
    <h1 class="section-title gold-gradient-text" style="font-size: 3.2rem;">PORTRAIT PHOTOGRAPHY</h1>
    <div class="section-divider"></div>
    <p style="max-width: 650px; margin: 20px auto 0; font-size: 1.05rem; color: var(--text-secondary);">
      Intimate character studies, editorial fashion, cultural heritage, and personal portraits bathed in natural and studio golden lighting.
    </p>
  </div>
</section>

<!-- Portrait Gallery -->
<section class="section">
  <div class="container">
    <% if (photos.length === 0) { %>
      <div style="text-align: center; padding: 60px 0; color: var(--text-secondary);">
        <i class="fa-solid fa-user-gear gold-text" style="font-size: 3rem; margin-bottom: 16px; display: block;"></i>
        <h3>No portrait photos uploaded yet.</h3>
        <p>Check back soon or upload new works from the admin panel.</p>
      </div>
    <% } else { %>
      <div class="masonry-grid">
        <% photos.forEach(photo => { %>
          <div class="gallery-item" data-lightbox data-src="<%= photo.filename %>" data-title="<%= photo.title %>" data-desc="<%= photo.location %> — <%= photo.description %>">
            <img src="<%= photo.filename %>" alt="<%= photo.title %>" class="gallery-img">
            <div class="gallery-caption">
              <h4><%= photo.title %></h4>
              <p><i class="fa-solid fa-location-dot" style="margin-right: 4px;"></i> <%= photo.location %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<!-- Call to action -->
<section class="section section-darker" style="text-align: center;">
  <div class="container">
    <h2 class="section-title">BOOK YOUR PERSONAL PORTRAIT SESSION IN KIGALI</h2>
    <p style="max-width: 600px; margin: 0 auto 30px; color: var(--text-secondary);">
      Whether for personal character portraits, editorial lookbooks, or cultural heritage documentation, Wesley brings out your authentic aura.
    </p>
    <a href="/booking?service=1" class="btn btn-gold"><i class="fa-solid fa-camera"></i> Reserve Portrait Appointment</a>
  </div>
</section>

<%- include('partials/footer') %>
