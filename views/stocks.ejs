<%- include('partials/header', { title: 'Multi-Stock Warehouses & Intra-Depot Transfers' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6 max-w-7xl mx-auto">
  <!-- Header Banner -->
  <div class="pb-4 border-b border-[var(--c-border)] flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
          Multi-Stock Warehouses & Intra-Depot Transfers
        </h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <%= stocks ? stocks.length : 1 %> Active Warehouses
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Manage isolated physical inventory stocks, branch depots, and seamlessly transfer quantities across warehouses.
      </p>
    </div>

    <div class="flex items-center space-x-3">
      <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_stock) { %>
        <button onclick="openTransferModal()" 
          class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 text-xs font-bold transition-all shadow-lg shadow-amber-500/20 flex items-center space-x-2 cursor-pointer">
          <i data-lucide="arrow-right-left" class="w-4 h-4"></i>
          <span>Transfer Stock</span>
        </button>
      <% } %>

      <% if (user.role === 'manager' || user.role === 'superadmin') { %>
        <button onclick="openAddStockModal()" 
          class="px-4 py-2.5 rounded-xl bg-[var(--c-chip)] hover:bg-[var(--c-hover)] text-white border border-[var(--c-hover)] text-xs font-bold transition-all flex items-center space-x-2 cursor-pointer">
          <i data-lucide="plus-circle" class="w-4 h-4 text-amber-400"></i>
          <span>Add Warehouse Branch</span>
        </button>
      <% } %>
    </div>
  </div>

  <% if (typeof msg !== 'undefined' && msg) { %>
    <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-xs flex items-center space-x-2">
      <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
      <span><%= msg %></span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-3.5 bg-rose-500/10 border border-rose-500/30 rounded-xl text-rose-400 text-xs flex items-center space-x-2">
      <i data-lucide="alert-triangle" class="w-4 h-4 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Stock Warehouses Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% if (stocks && stocks.length > 0) { %>
      <% stocks.forEach(st => { %>
        <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl p-5 shadow-xl relative hover:border-amber-500/30 transition-all">
          <div class="flex items-start justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
                <i data-lucide="warehouse" class="w-5 h-5"></i>
              </div>
              <div>
                <div class="flex items-center space-x-2">
                  <h3 class="text-sm font-bold text-white"><%= st.name %></h3>
                </div>
                <p class="text-[11px] font-mono text-slate-400"><%= st.code %></p>
              </div>
            </div>

            <% if (st.is_main) { %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20">
                Primary Main
              </span>
            <% } else { %>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold text-slate-400 bg-slate-800 border border-slate-700">
                Branch Depot
              </span>
            <% } %>
          </div>

          <div class="mt-4 pt-4 border-t border-[var(--c-divide)] grid grid-cols-2 gap-3 text-xs">
            <div>
              <p class="text-[10px] text-slate-500 uppercase font-bold">Product Lines</p>
              <p class="text-sm font-bold text-white mt-0.5"><%= st.product_count || 0 %> items</p>
            </div>
            <div>
              <p class="text-[10px] text-slate-500 uppercase font-bold">Total Physical Units</p>
              <p class="text-sm font-bold text-slate-200 mt-0.5"><%= (st.total_units || 0).toLocaleString() %> units</p>
            </div>
            <div class="col-span-2">
              <p class="text-[10px] text-slate-500 uppercase font-bold">Inventory Valuation</p>
              <p class="text-sm font-mono font-bold text-amber-400 mt-0.5">RWF <%= (st.total_valuation || 0).toLocaleString('en-US') %></p>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--c-divide)] flex items-center justify-between text-[11px] text-slate-400">
            <span class="flex items-center space-x-1">
              <i data-lucide="map-pin" class="w-3 h-3 text-slate-500"></i>
              <span class="truncate max-w-[150px]"><%= st.location || 'Rwanda' %></span>
            </span>
            <span class="flex items-center space-x-1">
              <i data-lucide="user" class="w-3 h-3 text-slate-500"></i>
              <span><%= st.manager_name || 'Manager' %></span>
            </span>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <!-- Recent Intra-Depot Stock Transfers History -->
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl shadow-xl p-5 space-y-4">
    <div class="flex items-center justify-between">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider text-amber-400 flex items-center space-x-2">
        <i data-lucide="history" class="w-4 h-4"></i>
        <span>Intra-Depot Stock Movement & Transfer Trail</span>
      </h3>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[var(--c-border)] bg-[var(--c-panel2)] text-[10px] font-bold text-slate-400 uppercase">
            <th class="py-3 px-3">Date / Time</th>
            <th class="py-3 px-3">Product Transferred</th>
            <th class="py-3 px-3">From Warehouse</th>
            <th class="py-3 px-3">To Warehouse</th>
            <th class="py-3 px-3 text-center">Quantity</th>
            <th class="py-3 px-3">Transferred By</th>
            <th class="py-3 px-3">Notes</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--c-divide)]">
          <% if (transfers && transfers.length > 0) { %>
            <% transfers.forEach(t => { %>
              <tr class="hover:bg-[var(--c-input)] transition-colors">
                <td class="py-3 px-3 text-slate-400 font-mono text-[11px]">
                  <%= new Date(t.created_at).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                </td>
                <td class="py-3 px-3 font-bold text-white">
                  <%= t.product_name %>
                  <span class="block text-[10px] text-slate-500 font-mono"><%= t.product_sku %></span>
                </td>
                <td class="py-3 px-3 text-slate-300">
                  <span class="px-2 py-0.5 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 font-semibold">
                    <%= t.from_stock_name %>
                  </span>
                </td>
                <td class="py-3 px-3 text-slate-300">
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-semibold">
                    <%= t.to_stock_name %>
                  </span>
                </td>
                <td class="py-3 px-3 text-center font-mono font-bold text-amber-400">
                  <%= t.quantity %> units
                </td>
                <td class="py-3 px-3 text-slate-400">
                  <%= t.transferred_by_name || 'Staff' %>
                </td>
                <td class="py-3 px-3 text-slate-500 italic max-w-xs truncate">
                  <%= t.notes || '—' %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-6 text-center text-slate-500">
                No intra-warehouse stock transfers recorded yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Add New Warehouse Branch -->
<div id="addStockModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <h3 class="text-base font-bold text-white flex items-center space-x-2">
        <i data-lucide="warehouse" class="w-5 h-5 text-amber-400"></i>
        <span>Register Warehouse / Branch Stock</span>
      </h3>
      <button onclick="closeAddStockModal()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/stocks/add" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-slate-300 mb-1">Warehouse Name *</label>
        <input type="text" name="name" required placeholder="e.g. Gisozi Hardware Depot #2" 
          class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Depot Code</label>
          <input type="text" name="code" placeholder="e.g. WH-GIS-02" 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none uppercase font-mono">
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Location / Sector</label>
          <input type="text" name="location" placeholder="e.g. Gisozi, Gasabo" 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Depot In-Charge Name</label>
          <input type="text" name="manager_name" placeholder="Supervisor Name" 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Phone Number</label>
          <input type="text" name="phone" placeholder="0788..." 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
        </div>
      </div>

      <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl text-[11px] text-amber-300">
        Note: Additional active stocks expand your VectOS subscription tier (+RWF 5,000/month per stock depot).
      </div>

      <div class="flex items-center justify-end space-x-3 pt-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="closeAddStockModal()" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700">Cancel</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold shadow-md">Create Warehouse</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Stock Transfer Between Warehouses -->
<div id="transferModal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <h3 class="text-base font-bold text-white flex items-center space-x-2">
        <i data-lucide="arrow-right-left" class="w-5 h-5 text-amber-400"></i>
        <span>Transfer Inventory Between Depots</span>
      </h3>
      <button onclick="closeTransferModal()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/stocks/transfer" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-slate-300 mb-1">Select Product to Move *</label>
        <select name="product_id" id="transferProductSelect" required onchange="updateTransferAvailability()"
          class="w-full px-3 py-2.5 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
          <option value="">-- Choose Product --</option>
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <option value="<%= p.id %>" data-qty="<%= p.quantity %>" data-stock="<%= p.stock_id %>">
                <%= p.name %> (SKU: <%= p.sku %>) — Balance: <%= p.quantity %> units
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-300 mb-1">From Origin Warehouse *</label>
          <select name="from_stock_id" id="fromStockSelect" required
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
            <% if (stocks && stocks.length > 0) { %>
              <% stocks.forEach(st => { %>
                <option value="<%= st.id %>"><%= st.name %> (<%= st.code %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">To Destination Warehouse *</label>
          <select name="to_stock_id" id="toStockSelect" required
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
            <% if (stocks && stocks.length > 0) { %>
              <% stocks.forEach((st, idx) => { %>
                <option value="<%= st.id %>" <%= idx === 1 ? 'selected' : '' %>><%= st.name %> (<%= st.code %>)</option>
              <% }) %>
            <% } %>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-bold text-slate-300 mb-1">Quantity to Move *</label>
          <input type="number" name="quantity" min="1" required placeholder="Units" 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none font-mono">
        </div>
        <div>
          <label class="block font-bold text-slate-300 mb-1">Transfer Notes / Reason</label>
          <input type="text" name="notes" placeholder="e.g. Branch restocking for customer" 
            class="w-full px-3 py-2 bg-[var(--c-panel2)] border border-[var(--c-hover)] rounded-xl text-white focus:border-amber-400 outline-none">
        </div>
      </div>

      <div class="flex items-center justify-end space-x-3 pt-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="closeTransferModal()" class="px-4 py-2 rounded-xl bg-slate-800 text-slate-300 font-bold hover:bg-slate-700">Cancel</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 text-slate-950 font-bold shadow-md">Complete Transfer</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddStockModal() {
    document.getElementById('addStockModal').classList.remove('hidden');
  }
  function closeAddStockModal() {
    document.getElementById('addStockModal').classList.add('hidden');
  }
  function openTransferModal() {
    document.getElementById('transferModal').classList.remove('hidden');
  }
  function closeTransferModal() {
    document.getElementById('transferModal').classList.add('hidden');
  }
  function updateTransferAvailability() {
    const sel = document.getElementById('transferProductSelect');
    const opt = sel.options[sel.selectedIndex];
    if (opt && opt.dataset.stock) {
      document.getElementById('fromStockSelect').value = opt.dataset.stock;
    }
  }
</script>

<%- include('partials/footer') %>
