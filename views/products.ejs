<%- include('partials/header', { title: 'Construction Inventory & Bulk Stock Import — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Top Title & Action Buttons -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-[var(--c-border)]">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
          Construction Inventory Directory
        </h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <%= products.length %> Stock Lines
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Master inventory with fixed cost buying prices and real-time physical warehouse stock counts. Selling prices are negotiated dynamically per client.
      </p>
    </div>

    <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_manage_stock) { %>
      <div class="flex flex-wrap items-center gap-2.5">
        <!-- Download Template -->
        <a href="/products/sample-template" 
          class="inline-flex items-center space-x-1.5 px-3 py-2 rounded-xl bg-[var(--c-chip)] hover:bg-[var(--c-hover)] text-slate-200 border border-[var(--c-border2)] text-xs font-bold transition-all"
          title="Download pre-formatted Excel template for construction items">
          <i data-lucide="download" class="w-4 h-4 text-amber-400"></i>
          <span>Excel Template</span>
        </a>

        <!-- Bulk Excel Import Button -->
        <button onclick="document.getElementById('importExcelModal').classList.remove('hidden')"
          class="inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold transition-all cursor-pointer">
          <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
          <span>Bulk Excel/CSV Import</span>
        </button>

        <!-- Batch Quick Add -->
        <button onclick="document.getElementById('batchAddModal').classList.remove('hidden')"
          class="inline-flex items-center space-x-1.5 px-3.5 py-2 rounded-xl bg-[var(--c-input)] hover:bg-[var(--c-border2)] text-amber-300 border border-amber-500/30 text-xs font-bold transition-all cursor-pointer">
          <i data-lucide="list-plus" class="w-4 h-4"></i>
          <span>Fast Batch Entry</span>
        </button>

        <!-- Single Product Add -->
        <button onclick="document.getElementById('addProductModal').classList.remove('hidden')"
          class="inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-xs shadow-lg shadow-amber-500/20 transition-all cursor-pointer">
          <i data-lucide="plus" class="w-4 h-4"></i>
          <span>Add Product</span>
        </button>
      </div>
    <% } %>
  </div>

  <% if (typeof msg !== 'undefined' && msg) { %>
    <div class="p-3.5 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-xs flex items-center space-x-2">
      <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
      <span><%= msg %></span>
    </div>
  <% } %>

  <!-- Search & Category Filters -->
  <form action="/products" method="GET" class="bg-[var(--c-panel)] border border-[var(--c-border)] p-4 rounded-2xl flex flex-col sm:flex-row gap-3">
    <div class="flex-1 relative">
      <i data-lucide="search" class="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5"></i>
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by product name, SKU / barcode, or description..."
        hx-get="/products/search" hx-trigger="keyup changed delay:350ms, search" hx-target="#productsTableBody" hx-swap="innerHTML"
        class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 transition-all">
    </div>

    <div class="w-full sm:w-56">
      <select name="category" onchange="this.form.submit()"
        class="w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition-all">
        <option value="">All Categories</option>
        <% categories.forEach(cat => { %>
          <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
        <% }) %>
      </select>
    </div>

    <button type="submit" class="px-5 py-2.5 rounded-xl bg-[var(--c-btn)] hover:bg-[var(--c-hover)] text-xs font-bold text-white transition-colors cursor-pointer">
      Filter
    </button>
  </form>

  <!-- Products Table -->
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[var(--c-border)] bg-[var(--c-panel2)] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4">SKU / Code</th>
            <th class="py-3.5 px-4">Product Name</th>
            <th class="py-3.5 px-4">Category</th>
            <th class="py-3.5 px-4 text-right">Buying Price (RWF)</th>
            <th class="py-3.5 px-4 text-center">Available Stock</th>
            <th class="py-3.5 px-4 text-center">Status</th>
            <% if (user.role === 'storekeeper' || user.role === 'manager' || user.role === 'superadmin' || user.can_manage_stock || user.can_release_stock) { %>
              <th class="py-3.5 px-4 text-right">Stock Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--c-divide)] text-xs" id="productsTableBody">
          <%- include('partials/product_rows') %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Bulk Excel Import Modal -->
<div id="importExcelModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-lg p-6 space-y-5 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
          <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white">Bulk Excel / CSV Inventory Import</h3>
          <p class="text-[11px] text-slate-400">Add or update thousands of products in one click</p>
        </div>
      </div>
      <button onclick="document.getElementById('importExcelModal').classList.add('hidden')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/products/import-excel" method="POST" enctype="multipart/form-data" class="space-y-4">
      <!-- Drag & Drop Zone -->
      <div class="border-2 border-dashed border-[var(--c-border2)] hover:border-amber-500 rounded-2xl p-6 text-center bg-[var(--c-panel)] transition-all cursor-pointer"
           onclick="document.getElementById('excelFileInput').click()">
        <input type="file" id="excelFileInput" name="file" accept=".xlsx,.xls,.csv" required class="hidden" onchange="updateFileName(this)">
        <div class="space-y-2">
          <i data-lucide="upload-cloud" class="w-8 h-8 text-amber-400 mx-auto"></i>
          <p id="fileLabel" class="text-xs font-bold text-white">Click or Drag & Drop Excel (.xlsx, .xls) or CSV (.csv)</p>
          <p class="text-[10px] text-slate-400">Max file size: 10MB • Auto-detects product names, SKU, buying price & initial stock.</p>
        </div>
      </div>

      <!-- Guidelines Box -->
      <div class="p-3 bg-[var(--c-panel2)] border border-[var(--c-border)] rounded-xl space-y-1.5 text-xs text-slate-300">
        <div class="flex items-center justify-between font-bold text-amber-400">
          <span>Supported Column Names:</span>
          <a href="/products/sample-template" class="text-[11px] text-emerald-400 hover:underline flex items-center space-x-1">
            <i data-lucide="download" class="w-3 h-3"></i>
            <span>Get Template.xlsx</span>
          </a>
        </div>
        <p class="text-[11px] text-slate-400 font-mono">
          Product Name • SKU / Code • Category • Unit • Buying Price • Initial Quantity • Low Stock Alert • Description
        </p>
      </div>

      <div class="pt-2 flex justify-end space-x-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="document.getElementById('importExcelModal').classList.add('hidden')"
          class="px-4 py-2.5 rounded-xl bg-[var(--c-btn)] text-xs font-bold text-slate-300 hover:bg-[var(--c-border2)] cursor-pointer">Cancel</button>
        <button type="submit"
          class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 text-slate-950 font-bold text-xs hover:from-emerald-400 hover:to-emerald-500 shadow-md shadow-emerald-500/20 cursor-pointer">
          Start Bulk Upload
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Fast Batch Quick Entry Modal -->
<div id="batchAddModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-3xl p-6 space-y-5 shadow-2xl my-8">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <div>
        <h3 class="text-base font-bold text-white">Fast Batch Product Entry</h3>
        <p class="text-xs text-slate-400">Quickly type multiple construction items into the inventory at once.</p>
      </div>
      <button onclick="document.getElementById('batchAddModal').classList.add('hidden')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="batchAddForm" action="/products/batch-add" method="POST" onsubmit="prepareBatchSubmission(event)" class="space-y-4">
      <input type="hidden" id="batch_items_input" name="batch_items">

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="border-b border-[var(--c-border)] bg-[var(--c-panel2)] text-[10px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-2 px-2">Product Name *</th>
              <th class="py-2 px-2">Category</th>
              <th class="py-2 px-2 w-20">Unit</th>
              <th class="py-2 px-2 w-28">Buying Price (RWF) *</th>
              <th class="py-2 px-2 w-20">Stock Qty</th>
              <th class="py-2 px-2 text-center w-10"></th>
            </tr>
          </thead>
          <tbody id="batchRowsContainer" class="divide-y divide-[var(--c-divide)]">
            <!-- Row 1 -->
            <tr class="batch-row">
              <td class="py-2 px-2">
                <input type="text" class="b-name w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="e.g. Nails 3 inch (kg)" required>
              </td>
              <td class="py-2 px-2">
                <input type="text" class="b-cat w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="Fasteners" value="Fasteners">
              </td>
              <td class="py-2 px-2">
                <input type="text" class="b-unit w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="kg" value="kg">
              </td>
              <td class="py-2 px-2">
                <input type="number" step="0.01" class="b-price w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white font-mono" placeholder="1200" required>
              </td>
              <td class="py-2 px-2">
                <input type="number" class="b-qty w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white font-mono" placeholder="50" value="50">
              </td>
              <td class="py-2 px-2 text-center">
                <button type="button" onclick="removeBatchRow(this)" class="text-slate-500 hover:text-rose-400 p-1">
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between pt-2">
        <button type="button" onclick="addBatchRow()" class="px-3 py-1.5 rounded-lg bg-[var(--c-btn)] hover:bg-[var(--c-hover)] text-amber-400 text-xs font-bold flex items-center space-x-1.5 cursor-pointer">
          <i data-lucide="plus" class="w-3.5 h-3.5"></i>
          <span>+ Add Another Row</span>
        </button>

        <div class="flex space-x-3">
          <button type="button" onclick="document.getElementById('batchAddModal').classList.add('hidden')"
            class="px-4 py-2 rounded-xl bg-[var(--c-btn)] text-xs font-bold text-slate-300 hover:bg-[var(--c-border2)] cursor-pointer">Cancel</button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 text-slate-950 font-bold text-xs hover:from-amber-300 hover:to-amber-500 shadow-md shadow-amber-500/20 cursor-pointer">
            Save All Items
          </button>
        </div>
      </div>
    </form>
  </div>
</div>

<!-- Stock Adjustment Modal -->
<div id="stockModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <h3 class="text-base font-bold text-white" id="modalProdTitle">Adjust Stock</h3>
      <button onclick="document.getElementById('stockModal').classList.add('hidden')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/products/adjust-stock" method="POST" class="space-y-4">
      <input type="hidden" id="modalProdId" name="product_id">

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Adjustment Type</label>
        <select name="movement_type" required class="mt-1.5 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
          <option value="Stock Received">Stock Received (+) Supplier Delivery</option>
          <option value="Adjustment">Manual Physical Count Adjustment (+/-)</option>
          <option value="Damage">Damaged / Broken Goods (-)</option>
          <option value="Return">Customer Return (+)</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Quantity Change (+ or -)</label>
        <input type="number" name="adjustment_qty" required placeholder="e.g. 50 or -5"
          class="mt-1.5 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
        <p class="text-[10px] text-slate-500 mt-1">Use positive numbers to add stock, negative to reduce.</p>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Reference / Batch Note</label>
        <input type="text" name="reference" placeholder="e.g. Supplier Invoice #9821 or Physical Count"
          class="mt-1.5 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div class="pt-3 flex justify-end space-x-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="document.getElementById('stockModal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl bg-[var(--c-btn)] text-xs font-bold text-slate-300 hover:text-white cursor-pointer">Cancel</button>
        <button type="submit"
          class="px-5 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs hover:bg-amber-400 cursor-pointer">Save Stock Adjustment</button>
      </div>
    </form>
  </div>
</div>

<!-- Single Add Product Modal -->
<div id="addProductModal" class="hidden fixed inset-0 z-50 bg-black/75 flex items-center justify-center p-4">
  <div class="bg-[var(--c-panel)] border border-[var(--c-border)] rounded-2xl w-full max-w-lg p-6 space-y-4 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[var(--c-border)]">
      <h3 class="text-base font-bold text-white">Add New Product to Directory</h3>
      <button onclick="document.getElementById('addProductModal').classList.add('hidden')" class="text-slate-400 hover:text-white cursor-pointer">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/products/add" method="POST" class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div class="col-span-2">
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Product Name *</label>
          <input type="text" name="name" required placeholder="e.g. CIMERWA Cement 32.5R (50kg)"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">SKU / Item Code</label>
          <input type="text" name="sku" placeholder="e.g. CEM-325R"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Category *</label>
          <input type="text" name="category" required placeholder="e.g. Cement, Steel, Roofing, Plumbing"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Buying Price (RWF) *</label>
          <input type="number" step="0.01" name="buying_price" required placeholder="10500"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Unit of Measure</label>
          <input type="text" name="unit" placeholder="Bag, Bar, Sheet, Piece, Truck" value="pcs"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Initial Stock Quantity</label>
          <input type="number" name="initial_quantity" value="0"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Low Stock Alert Threshold</label>
          <input type="number" name="low_stock_threshold" value="10"
            class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">Description / Specs</label>
        <textarea name="description" rows="2" placeholder="Specifications, grade, or supplier note..."
          class="mt-1 w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-xl px-3 py-2 text-sm text-white focus:border-amber-500"></textarea>
      </div>

      <div class="pt-3 flex justify-end space-x-3 border-t border-[var(--c-border)]">
        <button type="button" onclick="document.getElementById('addProductModal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl bg-[var(--c-btn)] text-xs font-bold text-slate-300 cursor-pointer">Cancel</button>
        <button type="submit"
          class="px-5 py-2 rounded-xl bg-amber-500 text-slate-950 font-bold text-xs hover:bg-amber-400 cursor-pointer">Save Product</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openStockModal(id, name, currentStock) {
    document.getElementById('modalProdId').value = id;
    document.getElementById('modalProdTitle').innerText = 'Adjust Stock: ' + name + ' (Current: ' + currentStock + ')';
    document.getElementById('stockModal').classList.remove('hidden');
  }

  function updateFileName(input) {
    if (input.files && input.files[0]) {
      document.getElementById('fileLabel').textContent = 'Selected: ' + input.files[0].name + ' (' + Math.round(input.files[0].size / 1024) + ' KB)';
    }
  }

  function addBatchRow() {
    const container = document.getElementById('batchRowsContainer');
    const tr = document.createElement('tr');
    tr.className = 'batch-row';
    tr.innerHTML = `
      <td class="py-2 px-2">
        <input type="text" class="b-name w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="Product name" required>
      </td>
      <td class="py-2 px-2">
        <input type="text" class="b-cat w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="Category" value="General">
      </td>
      <td class="py-2 px-2">
        <input type="text" class="b-unit w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white" placeholder="pcs" value="pcs">
      </td>
      <td class="py-2 px-2">
        <input type="number" step="0.01" class="b-price w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white font-mono" placeholder="Cost" required>
      </td>
      <td class="py-2 px-2">
        <input type="number" class="b-qty w-full bg-[var(--c-input)] border border-[var(--c-border2)] rounded-lg px-2 py-1.5 text-xs text-white font-mono" placeholder="0" value="0">
      </td>
      <td class="py-2 px-2 text-center">
        <button type="button" onclick="removeBatchRow(this)" class="text-slate-500 hover:text-rose-400 p-1 cursor-pointer">
          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
        </button>
      </td>
    `;
    container.appendChild(tr);
    if (window.lucide) window.lucide.createIcons();
  }

  function removeBatchRow(btn) {
    const rows = document.querySelectorAll('.batch-row');
    if (rows.length > 1) {
      btn.closest('tr').remove();
    }
  }

  function prepareBatchSubmission(e) {
    const rows = document.querySelectorAll('.batch-row');
    const items = [];
    rows.forEach(r => {
      const name = r.querySelector('.b-name').value.trim();
      const cat = r.querySelector('.b-cat').value.trim();
      const unit = r.querySelector('.b-unit').value.trim();
      const price = parseFloat(r.querySelector('.b-price').value) || 0;
      const qty = parseInt(r.querySelector('.b-qty').value, 10) || 0;
      if (name) {
        items.push({ name, category: cat, unit, buying_price: price, quantity: qty });
      }
    });

    if (items.length === 0) {
      e.preventDefault();
      alert('Please enter at least one product with name and buying price.');
      return;
    }
    document.getElementById('batch_items_input').value = JSON.stringify(items);
  }
</script>

