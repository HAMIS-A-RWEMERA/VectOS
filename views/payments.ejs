<%- include('partials/header', { title: 'Payments & Receivables — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="pb-4 border-b border-[#222732] flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-extrabold text-white tracking-tight font-display">
        Payments & Accounts Receivable
      </h1>
      <p class="text-xs text-slate-400 mt-1">
        Record payments, manage outstanding credit debts, and review payment transaction logs.
      </p>
    </div>

    <% if (user.role === 'accountant' || user.role === 'manager') { %>
      <button onclick="document.getElementById('recordPaymentModal').classList.remove('hidden')"
        class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Record New Payment</span>
      </button>
    <% } %>
  </div>

  <% if (user.role !== 'accountant' && user.role !== 'manager') { %>
    <div class="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 text-xs text-amber-300 flex items-start space-x-3 shadow-lg">
      <i data-lucide="shield-alert" class="w-5 h-5 text-amber-400 shrink-0 mt-0.5"></i>
      <div>
        <p class="font-bold text-sm text-amber-400">Read-Only View Mode (<%= user.role.toUpperCase() %>)</p>
        <p class="mt-0.5 text-amber-200/80">You are monitoring payment logs and customer debt balances. Recording new payment transactions is handled by the Accountant and Manager accounts.</p>
      </div>
    </div>
  <% } %>

  <!-- Outstanding Debt Orders List -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden p-5 space-y-4">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider text-rose-400">
      Orders with Outstanding Credit Debt
    </h3>

    <% if (debtOrders && debtOrders.length > 0) { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="border-b border-[#222732] bg-[#181C24] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
              <th class="py-3 px-3">Order No</th>
              <th class="py-3 px-3">Customer</th>
              <th class="py-3 px-3 text-right">Total Amount (RWF)</th>
              <th class="py-3 px-3 text-right">Paid So Far (RWF)</th>
              <th class="py-3 px-3 text-right">Remaining Debt (RWF)</th>
              <th class="py-3 px-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1D222B]">
            <% debtOrders.forEach(d => { %>
              <tr class="hover:bg-[#1A1E26] transition-colors">
                <td class="py-3.5 px-3 font-mono font-bold text-amber-400"><%= d.order_number %></td>
                <td class="py-3.5 px-3 font-bold text-white"><%= d.customer_name %> (<%= d.customer_phone %>)</td>
                <td class="py-3.5 px-3 text-right font-mono font-bold text-slate-200"><%= d.total_amount.toLocaleString('en-US') %></td>
                <td class="py-3.5 px-3 text-right font-mono text-emerald-400 font-bold"><%= d.paid_amount.toLocaleString('en-US') %></td>
                <td class="py-3.5 px-3 text-right font-mono text-rose-400 font-bold"><%= d.debt_amount.toLocaleString('en-US') %></td>
                <td class="py-3.5 px-3 text-right">
                  <% if (user.role === 'accountant' || user.role === 'manager') { %>
                    <button onclick="openPaymentForOrder('<%= d.id %>', '<%= d.order_number %>', '<%= d.debt_amount %>')"
                      class="px-3 py-1.5 rounded-lg bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-xs transition-colors">
                      Collect Payment
                    </button>
                  <% } else { %>
                    <span class="text-[11px] font-medium text-slate-400 italic">
                      Accountant/Manager Processing
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <p class="text-xs text-slate-500 py-4 text-center">No outstanding order debts currently active.</p>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Payments Transaction Log -->
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl shadow-xl overflow-hidden p-5 space-y-4">
    <h3 class="text-sm font-bold text-white uppercase tracking-wider text-teal-400">
      Recent Payment Transaction Records
    </h3>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-[#222732] bg-[#181C24] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3 px-3">Date & Time</th>
            <th class="py-3 px-3">Order No</th>
            <th class="py-3 px-3">Customer</th>
            <th class="py-3 px-3 text-right">Amount Paid</th>
            <th class="py-3 px-3 text-center">Payment Method</th>
            <th class="py-3 px-3">Reference No</th>
            <th class="py-3 px-3">Recorded By</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#1D222B]">
          <% payments.forEach(p => { %>
            <tr class="hover:bg-[#1A1E26] transition-colors">
              <td class="py-3 px-3 text-slate-400"><%= new Date(p.created_at).toLocaleString() %></td>
              <td class="py-3 px-3 font-mono font-bold text-amber-400"><%= p.order_number %></td>
              <td class="py-3 px-3 font-bold text-white"><%= p.customer_name %></td>
              <td class="py-3 px-3 text-right font-mono font-bold text-emerald-400">RWF <%= p.amount.toLocaleString('en-US') %></td>
              <td class="py-3 px-3 text-center">
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase bg-[#222834] text-slate-300">
                  <%= p.payment_method %>
                </span>
              </td>
              <td class="py-3 px-3 font-mono text-slate-300"><%= p.reference_no || '-' %></td>
              <td class="py-3 px-3 text-slate-300">
                <span class="font-bold text-white"><%= p.recorded_by_name %></span>
                <span class="ml-1 text-[10px] px-2 py-0.5 rounded-full font-mono uppercase bg-slate-800 text-amber-400 border border-slate-700">
                  <%= p.recorded_by_role || 'user' %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Record Payment Modal -->
<% if (user.role === 'accountant' || user.role === 'manager') { %>
<div id="recordPaymentModal" class="hidden fixed inset-0 z-50 bg-black/70 flex items-center justify-center p-4">
  <div class="bg-[#13161C] border border-[#222732] rounded-2xl w-full max-w-md p-6 space-y-4 shadow-2xl">
    <div class="flex items-center justify-between pb-3 border-b border-[#222732]">
      <h3 class="text-base font-bold text-white" id="modalPaymentTitle">Record Order Payment</h3>
      <button onclick="document.getElementById('recordPaymentModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form action="/payments/record" method="POST" class="space-y-4">
      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Select Debt Order</label>
        <select name="order_id" id="modalOrderSelect" required class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
          <% debtOrders.forEach(d => { %>
            <option value="<%= d.id %>"><%= d.order_number %> — <%= d.customer_name %> (Debt: RWF <%= d.debt_amount.toLocaleString('en-US') %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Payment Amount (RWF)</label>
        <input type="number" step="0.01" name="payment_amount" id="modalPaymentAmount" required placeholder="Enter amount"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Payment Method</label>
        <select name="payment_method" required class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
          <option value="cash">Cash Payment</option>
          <option value="momo">MTN Mobile Money (MoMo)</option>
          <option value="bank_transfer">Bank Wire / Transfer</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Transaction / Reference No</label>
        <input type="text" name="reference_no" placeholder="e.g. MM-20260804-1029"
          class="w-full bg-[#1A1E26] border border-[#2B313E] rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
      </div>

      <div class="pt-3 flex justify-end space-x-3">
        <button type="button" onclick="document.getElementById('recordPaymentModal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl bg-[#222834] text-xs font-bold text-slate-300">Cancel</button>
        <button type="submit"
          class="px-5 py-2 rounded-xl bg-teal-500 text-slate-950 font-bold text-xs hover:bg-teal-400">Save Payment</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<script>
  function openPaymentForOrder(orderId, orderNum, maxDebt) {
    document.getElementById('modalOrderSelect').value = orderId;
    document.getElementById('modalPaymentAmount').value = maxDebt;
    document.getElementById('modalPaymentTitle').innerText = `Record Payment for ${orderNum}`;
    document.getElementById('recordPaymentModal').classList.remove('hidden');
  }
</script>

<%- include('partials/footer') %>
