<%- include('partials/header', { title: 'Dashboard — VectOS' }) %>
<%- include('partials/sidebar') %>

<div class="space-y-6">
  <!-- Top Welcome Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-[#222732]">
    <div>
      <div class="flex items-center space-x-2">
        <h1 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight font-display">
          Welcome back, <%= user.name %>
        </h1>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/20">
          <%= user.role %>
        </span>
      </div>
      <p class="text-xs md:text-sm text-slate-400 mt-1">
        Kigali Construction Depot Operations & Order Processing Center
      </p>
    </div>

    <% if (user.role === 'salesperson' || user.role === 'manager') { %>
      <a href="/orders/new" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all">
        <i data-lucide="plus-circle" class="w-4 h-4"></i>
        <span>Create New Order</span>
      </a>
    <% } %>
  </div>

  <!-- KPI Metrics Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Today's Sales -->
    <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/40 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Today's Sales</span>
        <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
          <i data-lucide="trending-up" class="w-5 h-5"></i>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-2xl font-black text-white font-mono">
          RWF <%= kpis.todaySalesTotal.toLocaleString('en-US') %>
        </p>
        <p class="text-xs text-slate-400 mt-1">
          <%= kpis.todaySalesCount %> order(s) placed today
        </p>
      </div>
    </div>

    <!-- Today's Profit (Guarded by Permission) -->
    <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/40 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
          <%= (user.role === 'manager' || user.role === 'superadmin' || user.can_view_buying_prices || user.can_view_reports) ? "Today's Gross Profit" : "Dispatched Orders" %>
        </span>
        <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center">
          <i data-lucide="<%= (user.role === 'manager' || user.role === 'superadmin' || user.can_view_buying_prices || user.can_view_reports) ? 'dollar-sign' : 'truck' %>" class="w-5 h-5"></i>
        </div>
      </div>
      <div class="mt-4">
        <% if (user.role === 'manager' || user.role === 'superadmin' || user.can_view_buying_prices || user.can_view_reports) { %>
          <p class="text-2xl font-black text-amber-400 font-mono">
            RWF <%= kpis.todayProfit.toLocaleString('en-US') %>
          </p>
          <p class="text-xs text-slate-400 mt-1">
            Calculated dynamically per item
          </p>
        <% } else { %>
          <p class="text-2xl font-black text-white font-mono">
            <%= kpis.todaySalesCount %> Dispatched
          </p>
          <p class="text-xs text-slate-400 mt-1">
            Active daily fulfillment
          </p>
        <% } %>
      </div>
    </div>

    <!-- Total Inventory Value -->
    <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/40 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Inventory Valuation</span>
        <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center">
          <i data-lucide="package" class="w-5 h-5"></i>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-2xl font-black text-white font-mono">
          RWF <%= kpis.inventoryValue.toLocaleString('en-US') %>
        </p>
        <p class="text-xs text-slate-400 mt-1">
          <%= kpis.totalProductLines %> active product lines
        </p>
      </div>
    </div>

    <!-- Customer Receivables / Debts -->
    <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl relative overflow-hidden group hover:border-amber-500/40 transition-all">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Outstanding Debts</span>
        <div class="w-9 h-9 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center">
          <i data-lucide="credit-card" class="w-5 h-5"></i>
        </div>
      </div>
      <div class="mt-4">
        <p class="text-2xl font-black text-rose-400 font-mono">
          RWF <%= kpis.totalCustomerDebt.toLocaleString('en-US') %>
        </p>
        <p class="text-xs text-slate-400 mt-1">
          Owed by credit customers
        </p>
      </div>
    </div>
  </div>

  <!-- Operational Action Queues -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Storekeeper Pending Dispatch Queue -->
    <a href="/storekeeper" class="p-5 rounded-2xl bg-[#13161C] border border-[#222732] hover:border-orange-500/50 transition-all flex items-center justify-between group">
      <div class="flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-orange-500/10 text-orange-400 flex items-center justify-center font-bold text-lg">
          <i data-lucide="warehouse" class="w-6 h-6"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white group-hover:text-orange-400 transition-colors">Storekeeper Queue</h3>
          <p class="text-xs text-slate-400">Orders waiting for stock dispatch review</p>
        </div>
      </div>
      <div class="px-3.5 py-1.5 rounded-xl bg-orange-500/20 text-orange-300 font-black text-sm border border-orange-500/30">
        <%= kpis.pendingStoreCount %> Pending
      </div>
    </a>

    <!-- Accountant Rejected Resolution Queue -->
    <a href="/accountant/rejected-items" class="p-5 rounded-2xl bg-[#13161C] border border-[#222732] hover:border-rose-500/50 transition-all flex items-center justify-between group">
      <div class="flex items-center space-x-4">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center font-bold text-lg">
          <i data-lucide="refresh-cw" class="w-6 h-6"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-white group-hover:text-rose-400 transition-colors">Rejected Items Queue</h3>
          <p class="text-xs text-slate-400">Items rejected by store requiring Partner Shop or Unavailable action</p>
        </div>
      </div>
      <div class="px-3.5 py-1.5 rounded-xl bg-rose-500/20 text-rose-300 font-black text-sm border border-rose-500/30">
        <%= kpis.pendingAccountantCount %> Action Needed
      </div>
    </a>
  </div>

  <!-- Low Stock Alert Banner & Recent Activity -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Recent Orders (2 Columns) -->
    <div class="lg:col-span-2 bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-base font-bold text-white flex items-center space-x-2">
          <i data-lucide="shopping-cart" class="w-5 h-5 text-amber-500"></i>
          <span>Recent Orders</span>
        </h3>
        <a href="/orders" class="text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors">View All Orders &rarr;</a>
      </div>

      <% if (recentOrders && recentOrders.length > 0) { %>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[#222732] text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                <th class="py-3 px-3">Order No</th>
                <th class="py-3 px-3">Customer</th>
                <th class="py-3 px-3 text-right">Total (RWF)</th>
                <th class="py-3 px-3 text-center">Payment</th>
                <th class="py-3 px-3 text-center">Fulfillment</th>
                <th class="py-3 px-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#1D222B] text-xs">
              <% recentOrders.forEach(o => { %>
                <tr class="hover:bg-[#1A1E26] transition-colors">
                  <td class="py-3 px-3 font-mono font-bold text-amber-400"><%= o.order_number %></td>
                  <td class="py-3 px-3 text-white font-medium"><%= o.customer_name %></td>
                  <td class="py-3 px-3 text-right font-mono font-bold text-slate-200">
                    <%= o.total_amount.toLocaleString('en-US') %>
                  </td>
                  <td class="py-3 px-3 text-center">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= o.payment_status === 'paid' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : o.payment_status === 'partial' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                      <%= o.payment_status %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-center">
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider <%= o.fulfillment_status === 'completed' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : o.fulfillment_status === 'resolving_rejected' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' : 'bg-blue-500/10 text-blue-400 border border-blue-500/20' %>">
                      <%= o.fulfillment_status.replace('_', ' ') %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-right">
                    <a href="/orders/<%= o.id %>" class="px-2.5 py-1 rounded-lg bg-[#222834] hover:bg-[#2C3444] text-slate-300 font-medium transition-colors">
                      View
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="text-xs text-slate-500 py-6 text-center">No recent orders logged yet.</p>
      <% } %>
    </div>

    <!-- Low Stock Alerts (1 Column) -->
    <div class="bg-[#13161C] border border-[#222732] rounded-2xl p-5 shadow-xl flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base font-bold text-white flex items-center space-x-2">
            <i data-lucide="alert-triangle" class="w-5 h-5 text-amber-400"></i>
            <span>Low Stock Alerts</span>
          </h3>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300">
            <%= kpis.lowStockCount %> Items
          </span>
        </div>

        <% if (lowStockProducts && lowStockProducts.length > 0) { %>
          <div class="space-y-3">
            <% lowStockProducts.forEach(p => { %>
              <div class="p-3 rounded-xl bg-[#1A1E26] border border-[#2B313E] flex items-center justify-between">
                <div>
                  <p class="text-xs font-bold text-white"><%= p.name %></p>
                  <p class="text-[10px] text-slate-400"><%= p.category %> • Threshold: <%= p.low_stock_threshold %> <%= p.unit %></p>
                </div>
                <div class="text-right">
                  <span class="text-xs font-mono font-black text-rose-400"><%= p.quantity %> <%= p.unit %></span>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-6 text-center text-xs text-slate-500">
            <i data-lucide="check-circle-2" class="w-8 h-8 text-emerald-500/50 mx-auto mb-2"></i>
            All inventory levels are healthy.
          </div>
        <% } %>
      </div>

      <div class="mt-6 pt-4 border-t border-[#222732]">
        <a href="/products" class="w-full inline-flex justify-center items-center py-2.5 px-4 rounded-xl bg-[#1F242E] hover:bg-[#282F3D] text-xs font-bold text-white transition-colors">
          Manage Stock Levels &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
