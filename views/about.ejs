<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Header Banner -->
<section style="padding: 140px 0 60px; background: linear-gradient(to bottom, rgba(17, 17, 17, 0.8), var(--bg-primary)), url('/src/assets/images/hero_background_1785877478689.jpg') center/cover; text-align: center; border-bottom: 1px solid var(--border-subtle);">
  <div class="container">
    <span class="section-subtitle">THE STORYTELLER</span>
    <h1 class="section-title gold-gradient-text" style="font-size: 3.2rem;">ABOUT WESLEY</h1>
    <div class="section-divider"></div>
  </div>
</section>

<!-- Biography Section -->
<section class="section">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 60px; align-items: flex-start;">
      <div>
        <div style="border: 2px solid var(--border-gold); padding: 12px; border-radius: 8px; margin-bottom: 24px;">
          <img src="/src/assets/images/wesley_profile_1785877494136.jpg" alt="Wesley Director Portrait" style="width: 100%; border-radius: 6px; display: block;">
        </div>
        
        <div style="background: var(--bg-card); padding: 24px; border-radius: 8px; border: 1px solid var(--border-subtle);">
          <h4 class="gold-text" style="margin-bottom: 12px; font-family: var(--font-heading);">QUICK FACTS</h4>
          <p style="font-size: 0.9rem; margin-bottom: 8px;"><strong>Base:</strong> Kigali, Rwanda (Available Worldwide)</p>
          <p style="font-size: 0.9rem; margin-bottom: 8px;"><strong>Languages:</strong> Kinyarwanda, English, French</p>
          <p style="font-size: 0.9rem; margin-bottom: 8px;"><strong>Specializations:</strong> Narrative Directing, Cinematography, Fine-Art Portraiture</p>
          <p style="font-size: 0.9rem;"><strong>Camera Gear:</strong> RED Digital Cinema, Sony FX Cinema Series, Prime Lens Glass</p>
        </div>
      </div>

      <div>
        <span class="section-subtitle">MY JOURNEY</span>
        <h2 class="section-title" style="margin-bottom: 24px;">VOICE OF THE HILLS</h2>
        
        <p style="font-size: 1.1rem; line-height: 1.8; color: var(--text-primary); margin-bottom: 20px;">
          Born and raised among the mist-draped green hills of Rwanda, my journey into visual art began with a second-hand camera and an unyielding fascination for light, human expression, and memory.
        </p>

        <p style="line-height: 1.8; margin-bottom: 20px;">
          Growing up in Kigali during an era of unprecedented national rebirth, I witnessed firsthand how storytelling could heal wounds, ignite hope, and redefine how the world perceives Africa. I realized that for too long, foreign lenses had dictated African narratives. I chose to dedicate my life to changing that paradigm.
        </p>

        <p style="line-height: 1.8; margin-bottom: 30px;">
          Through my films and portrait photography, I focus on authentic African experiences — from the quiet strength of elders in rural villages to the dynamic rhythm of young innovators in urban Kigali. My work celebrates dignity, resilience, and unvarnished beauty.
        </p>

        <div style="border-left: 3px solid var(--accent-gold); padding-left: 20px; margin-bottom: 30px;">
          <p style="font-family: var(--font-heading); font-size: 1.15rem; color: var(--accent-gold); font-style: italic; line-height: 1.7;">
            "We are not defined by hardship; we are defined by our capacity to endure, create, love, and triumph."
          </p>
        </div>

        <a href="/booking" class="btn btn-gold"><i class="fa-solid fa-calendar-check"></i> Work With Wesley</a>
      </div>
    </div>
  </div>
</section>

<!-- Mission, Vision, Values -->
<section class="section section-darker">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">OUR FOUNDATION</span>
      <h2 class="section-title">MISSION, VISION & VALUES</h2>
      <div class="section-divider"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
      <div style="background: var(--bg-card); padding: 36px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <i class="fa-solid fa-compass gold-text" style="font-size: 2.2rem; margin-bottom: 16px; display: block;"></i>
        <h3 style="font-size: 1.4rem; margin-bottom: 12px; color: var(--text-primary);">Our Mission</h3>
        <p style="line-height: 1.7; color: var(--text-secondary);">
          To produce world-class films and fine-art photography that convey the true spirit of Africa, giving voice to authentic human experiences through uncompromised visual mastery.
        </p>
      </div>

      <div style="background: var(--bg-card); padding: 36px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <i class="fa-solid fa-eye gold-text" style="font-size: 2.2rem; margin-bottom: 16px; display: block;"></i>
        <h3 style="font-size: 1.4rem; margin-bottom: 12px; color: var(--text-primary);">Our Vision</h3>
        <p style="line-height: 1.7; color: var(--text-secondary);">
          To grow Wesley Studio into a premier African film production powerhouse, mentoring young Rwandan talent and competing on global cinema platforms.
        </p>
      </div>

      <div style="background: var(--bg-card); padding: 36px; border-radius: 8px; border: 1px solid var(--border-subtle);">
        <i class="fa-solid fa-gem gold-text" style="font-size: 2.2rem; margin-bottom: 16px; display: block;"></i>
        <h3 style="font-size: 1.4rem; margin-bottom: 12px; color: var(--text-primary);">Core Values</h3>
        <ul style="line-height: 1.8; color: var(--text-secondary); padding-left: 20px;">
          <li>Authenticity & Cultural Respect</li>
          <li>Cinematic Excellence & Rigor</li>
          <li>Compassion in Storytelling</li>
          <li>Community Empowerment</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Inspirations Section -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-subtitle">CREATIVE TOUCHSTONES</span>
      <h2 class="section-title">CINEMATIC INSPIRATIONS</h2>
      <div class="section-divider"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 30px;">
      <div style="background: var(--bg-secondary); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 28px;">
        <span class="gold-text" style="font-size: 0.8rem; text-transform: uppercase;">INSPIRATION #1</span>
        <h3 style="margin: 8px 0 12px; font-size: 1.3rem;">The Boy Who Harnessed the Wind</h3>
        <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-secondary);">
          Demonstrates how African innovation, family devotion, and perseverance can triumph over environmental hardship without losing emotional intimacy.
        </p>
      </div>

      <div style="background: var(--bg-secondary); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 28px;">
        <span class="gold-text" style="font-size: 0.8rem; text-transform: uppercase;">INSPIRATION #2</span>
        <h3 style="margin: 8px 0 12px; font-size: 1.3rem;">The Woman King</h3>
        <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-secondary);">
          A monument to African bravery, regal aesthetics, and scale, proving that historical African epics deserve massive visual splendor.
        </p>
      </div>

      <div style="background: var(--bg-secondary); border: 1px solid var(--border-subtle); border-radius: 8px; padding: 28px;">
        <span class="gold-text" style="font-size: 0.8rem; text-transform: uppercase;">INSPIRATION #3</span>
        <h3 style="margin: 8px 0 12px; font-size: 1.3rem;">Beasts of No Nation</h3>
        <p style="font-size: 0.9rem; line-height: 1.7; color: var(--text-secondary);">
          A masterclass in immersive cinematography, color saturation, and deeply empathetic performance during moments of intense turmoil.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
